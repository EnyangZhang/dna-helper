+/// 在 debug 目录内创建一次性标记；应用下次启动、日志初始化前执行完整清理。
+#[tauri::command]
+pub fn schedule_full_debug_clear() -> Result<(), String> {
+    let debug_dir = checked_debug_dir(true)?.ok_or_else(|| "无法创建日志目录".to_string())?;
+    let marker = debug_dir.join(DEBUG_CLEAR_MARKER);
+
+    if marker.exists() {
+        let metadata = std::fs::symlink_metadata(&marker)
+            .map_err(|e| format!("读取清理标记失败 [{}]: {}", marker.display(), e))?;
+        if !metadata.is_file() || metadata_is_link_or_reparse(&metadata) {
+            return Err(format!("拒绝覆盖异常清理标记 [{}]", marker.display()));
+        }
+    }
+
+    std::fs::write(&marker, b"clear debug directory on next start\n")
+        .map_err(|e| format!("写入清理标记失败 [{}]: {}", marker.display(), e))
+}
