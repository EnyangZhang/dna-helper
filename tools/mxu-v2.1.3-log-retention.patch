+//! Stop monitor communications and clean up verified orphan Agents locally.
+
+use serde::{Deserialize, Serialize};
+
+const MONITOR_DISCONNECT_SCHEMA_VERSION: u32 = 1;
+const MAX_MONITOR_DISCONNECT_BYTES: usize = 4096;
+
+#[derive(Clone, Debug, Default, Serialize)]
+#[serde(rename_all = "camelCase")]
+pub struct MonitorDisconnectSummary {
+    pub generation: Option<String>,
+    pub signal_error: Option<String>,
+    pub scan_error: Option<String>,
+    pub scanned_processes: usize,
+    pub orphan_agents_terminated: usize,
+    pub live_agents_preserved: usize,
+    pub stale_records: usize,
+    pub unverified_entries: usize,
+    pub failed_pids: Vec<u32>,
+}
+
+#[derive(Clone, Debug, Deserialize, Serialize)]
+#[serde(deny_unknown_fields)]
+struct AgentMarker {
+    schema_version: u32,
+    pid: u32,
+    creation_time_100ns: u64,
+    executable_path: String,
+}
+
+fn parse_agent_marker(bytes: &[u8], filename: &str) -> Result<AgentMarker, String> {
+    if bytes.is_empty() || bytes.len() >= 4096 {
+        return Err("Agent 登记文件大小无效".into());
+    }
+    let marker: AgentMarker =
+        serde_json::from_slice(bytes).map_err(|_| "Agent 登记文件内容无效".to_string())?;
+    if marker.schema_version != 1
+        || marker.pid == 0
+        || marker.creation_time_100ns == 0
+        || filename != format!("{}.json", marker.pid)
+        || !std::path::Path::new(&marker.executable_path).is_absolute()
+    {
+        return Err("Agent 登记文件身份无效".into());
+    }
+    let executable_name = std::path::Path::new(&marker.executable_path)
+        .file_name()
+        .and_then(|v| v.to_str())
+        .unwrap_or("")
+        .to_ascii_lowercase();
+    if !matches!(executable_name.as_str(), "python.exe" | "pythonw.exe") {
+        return Err("登记的进程不是 Python Agent".into());
+    }
+    Ok(marker)
+}
+
+#[derive(Clone, Debug, Deserialize, Serialize)]
+#[serde(deny_unknown_fields)]
+struct MonitorDisconnectSignal {
+    schema_version: u32,
+    generation: String,
+    created_at_unix_ms: u64,
+    source: String,
+}
+
+fn parse_monitor_disconnect_signal(bytes: &[u8]) -> Result<MonitorDisconnectSignal, String> {
+    if bytes.is_empty() || bytes.len() >= MAX_MONITOR_DISCONNECT_BYTES {
+        return Err(format!(
+            "监控通讯停止信号必须为小于 {MAX_MONITOR_DISCONNECT_BYTES} 字节的非空 JSON"
+        ));
+    }
+    let signal: MonitorDisconnectSignal = serde_json::from_slice(bytes)
+        .map_err(|error| format!("监控通讯停止信号 JSON 无效: {error}"))?;
+    if signal.schema_version != MONITOR_DISCONNECT_SCHEMA_VERSION {
+        return Err("监控通讯停止信号 schema_version 无效".to_string());
+    }
+    if signal.generation.is_empty() || signal.generation.len() > 200 {
+        return Err("监控通讯停止信号 generation 无效".to_string());
+    }
+    if signal.created_at_unix_ms == 0 {
+        return Err("监控通讯停止信号 created_at_unix_ms 无效".to_string());
+    }
+    if !matches!(signal.source.as_str(), "settings" | "telegram") {
+        return Err("监控通讯停止信号 source 无效".to_string());
+    }
+    Ok(signal)
+}
+
+/// Local-only cleanup. Telegram disconnect remains signal-only.
+#[tauri::command]
+pub async fn disconnect_all_dna_helper_monitors() -> Result<MonitorDisconnectSummary, String> {
+    #[cfg(windows)]
+    {
+        return tauri::async_runtime::spawn_blocking(
+            windows_impl::disconnect_all_dna_helper_monitors_windows,
+        )
+        .await
+        .map_err(|error| format!("清理监控任务失败: {error}"))?;
+    }
+
+    #[cfg(not(windows))]
+    {
+        Err("关闭所有监控通讯仅支持 Windows".to_string())
+    }
+}
+
+#[cfg(windows)]
+mod windows_impl {
+    use super::*;
+    use std::collections::HashMap;
+    use std::ffi::c_void;
+    use std::fs::OpenOptions;
+    use std::io::Write;
+    use std::os::windows::ffi::OsStrExt;
+    use std::os::windows::fs::MetadataExt;
+    use std::path::{Path, PathBuf};
+    use std::sync::atomic::{AtomicU64, Ordering};
+    use std::time::{SystemTime, UNIX_EPOCH};
+
+    const WINDOWS_FILE_ATTRIBUTE_REPARSE_POINT: u32 = 0x400;
+    const MOVEFILE_REPLACE_EXISTING: u32 = 0x1;
+    const MOVEFILE_WRITE_THROUGH: u32 = 0x8;
+    static SIGNAL_SEQUENCE: AtomicU64 = AtomicU64::new(0);
+    const PROCESS_QUERY_LIMITED_INFORMATION: u32 = 0x1000;
+    const PROCESS_TERMINATE: u32 = 0x0001;
+    const SYNCHRONIZE: u32 = 0x00100000;
+    const WAIT_OBJECT_0: u32 = 0;
+    const WAIT_TIMEOUT: u32 = 258;
+    const ERROR_INVALID_PARAMETER: i32 = 87;
+    const ERROR_NO_MORE_FILES: i32 = 18;
+    type Handle = *mut c_void;
+
+    #[repr(C)]
+    #[derive(Default)]
+    struct FileTime {
+        low: u32,
+        high: u32,
+    }
+
+    #[repr(C)]
+    struct ProcessEntry {
+        size: u32,
+        usage: u32,
+        pid: u32,
+        heap: usize,
+        module: u32,
+        threads: u32,
+        parent_pid: u32,
+        priority: i32,
+        flags: u32,
+        exe: [u16; 260],
+    }
+
+    struct OwnedHandle(Handle);
+    impl Drop for OwnedHandle {
+        fn drop(&mut self) {
+            unsafe {
+                CloseHandle(self.0);
+            }
+        }
+    }
+
+    #[derive(Debug, PartialEq)]
+    enum CleanupOutcome {
+        Terminated,
+        LiveParent,
+        Stale,
+        Unverified,
+    }
+
+    #[link(name = "kernel32")]
+    extern "system" {
+        fn CreateToolhelp32Snapshot(flags: u32, pid: u32) -> Handle;
+        fn Process32FirstW(snapshot: Handle, entry: *mut ProcessEntry) -> i32;
+        fn Process32NextW(snapshot: Handle, entry: *mut ProcessEntry) -> i32;
+        fn OpenProcess(access: u32, inherit: i32, pid: u32) -> Handle;
+        fn CloseHandle(handle: Handle) -> i32;
+        fn GetProcessTimes(
+            handle: Handle,
+            creation: *mut FileTime,
+            exit: *mut FileTime,
+            kernel: *mut FileTime,
+            user: *mut FileTime,
+        ) -> i32;
+        fn QueryFullProcessImageNameW(
+            handle: Handle,
+            flags: u32,
+            name: *mut u16,
+            size: *mut u32,
+        ) -> i32;
+        fn WaitForSingleObject(handle: Handle, timeout: u32) -> u32;
+        fn TerminateProcess(handle: Handle, exit_code: u32) -> i32;
+        fn MoveFileExW(
+            existing_file_name: *const u16,
+            new_file_name: *const u16,
+            flags: u32,
+        ) -> i32;
+    }
+
+    fn process_snapshot() -> Result<HashMap<u32, u32>, String> {
+        let raw = unsafe { CreateToolhelp32Snapshot(2, 0) };
+        if raw == (-1isize) as Handle {
+            return Err(format!(
+                "扫描系统进程失败: {}",
+                std::io::Error::last_os_error()
+            ));
+        }
+        let snapshot = OwnedHandle(raw);
+        let mut entry: ProcessEntry = unsafe { std::mem::zeroed() };
+        entry.size = std::mem::size_of::<ProcessEntry>() as u32;
+        let mut found = unsafe { Process32FirstW(snapshot.0, &mut entry) };
+        let mut processes = HashMap::new();
+        while found != 0 {
+            processes.insert(entry.pid, entry.parent_pid);
+            found = unsafe { Process32NextW(snapshot.0, &mut entry) };
+        }
+        let error = std::io::Error::last_os_error();
+        if error.raw_os_error() != Some(ERROR_NO_MORE_FILES) {
+            return Err(format!("系统进程扫描不完整，未终止任何进程: {error}"));
+        }
+        Ok(processes)
+    }
+
+    fn open_process(pid: u32, terminate: bool) -> Result<OwnedHandle, std::io::Error> {
+        let rights = PROCESS_QUERY_LIMITED_INFORMATION
+            | SYNCHRONIZE
+            | if terminate { PROCESS_TERMINATE } else { 0 };
+        let handle = unsafe { OpenProcess(rights, 0, pid) };
+        if handle.is_null() {
+            Err(std::io::Error::last_os_error())
+        } else {
+            Ok(OwnedHandle(handle))
+        }
+    }
+
+    fn creation_time(handle: &OwnedHandle) -> Result<u64, String> {
+        let (mut c, mut e, mut k, mut u) = (
+            FileTime::default(),
+            FileTime::default(),
+            FileTime::default(),
+            FileTime::default(),
+        );
+        if unsafe { GetProcessTimes(handle.0, &mut c, &mut e, &mut k, &mut u) } == 0 {
+            return Err(format!(
+                "读取进程创建时间失败: {}",
+                std::io::Error::last_os_error()
+            ));
+        }
+        Ok((u64::from(c.high) << 32) | u64::from(c.low))
+    }
+
+    fn executable_path(handle: &OwnedHandle) -> Result<PathBuf, String> {
+        let mut name = vec![0u16; 32768];
+        let mut size = name.len() as u32;
+        if unsafe { QueryFullProcessImageNameW(handle.0, 0, name.as_mut_ptr(), &mut size) } == 0 {
+            return Err(format!(
+                "读取进程路径失败: {}",
+                std::io::Error::last_os_error()
+            ));
+        }
+        use std::os::windows::ffi::OsStringExt;
+        let raw = PathBuf::from(std::ffi::OsString::from_wide(&name[..size as usize]));
+        std::fs::canonicalize(raw).map_err(|error| format!("解析进程路径失败: {error}"))
+    }
+
+    fn same_identity(handle: &OwnedHandle, marker: &AgentMarker) -> Result<bool, String> {
+        if creation_time(handle)? != marker.creation_time_100ns {
+            return Ok(false);
+        }
+        let registered_path = Path::new(&marker.executable_path);
+        validate_existing_ancestor_chain(registered_path)?;
+        let registered = std::fs::canonicalize(registered_path)
+            .map_err(|error| format!("解析 Agent 登记路径失败: {error}"))?;
+        Ok(executable_path(handle)? == registered)
+    }
+
+    fn parent_is_gone(parent_pid: u32, child_created: u64) -> Result<bool, String> {
+        // Unknown parent identity must never grant permission to terminate.
+        if parent_pid == 0 {
+            return Err("无法确认 Agent 父进程".into());
+        }
+        let parent = match open_process(parent_pid, false) {
+            Ok(parent) => parent,
+            Err(error) if error.raw_os_error() == Some(ERROR_INVALID_PARAMETER) => return Ok(true),
+            Err(error) => return Err(format!("无法核验父进程 {parent_pid}: {error}")),
+        };
+        match unsafe { WaitForSingleObject(parent.0, 0) } {
+            WAIT_OBJECT_0 => Ok(true),
+            WAIT_TIMEOUT => Ok(creation_time(&parent)? > child_created), // PID was reused.
+            _ => Err("无法确认父进程状态".into()),
+        }
+    }
+
+    fn inspect_and_cleanup(
+        marker: &AgentMarker,
+        parent_pid: u32,
+    ) -> Result<CleanupOutcome, String> {
+        if marker.pid == std::process::id() {
+            return Ok(CleanupOutcome::Unverified);
+        }
+        let child = match open_process(marker.pid, false) {
+            Ok(child) => child,
+            Err(error) if error.raw_os_error() == Some(ERROR_INVALID_PARAMETER) => {
+                return Ok(CleanupOutcome::Stale)
+            }
+            Err(error) => return Err(format!("无法核验 Agent {}: {error}", marker.pid)),
+        };
+        match unsafe { WaitForSingleObject(child.0, 0) } {
+            WAIT_OBJECT_0 => return Ok(CleanupOutcome::Stale),
+            WAIT_TIMEOUT => {}
+            _ => return Err("无法确认 Agent 状态".into()),
+        }
+        if !same_identity(&child, marker)? {
+            return Ok(CleanupOutcome::Unverified);
+        }
+        // Refresh parent identity while this exact child is pinned. A PID may have
+        // been recycled between the initial system snapshot and reading its marker.
+        let current = process_snapshot()?;
+        if current.get(&marker.pid) != Some(&parent_pid) {
+            return Ok(CleanupOutcome::Unverified);
+        }
+        if !parent_is_gone(parent_pid, marker.creation_time_100ns)? {
+            return Ok(CleanupOutcome::LiveParent);
+        }
+        // Keep the original handle pinned and revalidate the termination handle.
+        let target =
+            open_process(marker.pid, true).map_err(|error| format!("无法终止 Agent: {error}"))?;
+        if !same_identity(&target, marker)?
+            || !parent_is_gone(parent_pid, marker.creation_time_100ns)?
+        {
+            return Ok(CleanupOutcome::Unverified);
+        }
+        if unsafe { TerminateProcess(target.0, 0) } == 0 {
+            return Err(format!(
+                "终止残留 Agent 失败: {}",
+                std::io::Error::last_os_error()
+            ));
+        }
+        if unsafe { WaitForSingleObject(target.0, 2000) } != WAIT_OBJECT_0 {
+            return Err("已请求终止，但尚未确认残留 Agent 退出".into());
+        }
+        Ok(CleanupOutcome::Terminated)
+    }
+
+    fn cleanup_registered_orphans(
+        registry: &Path,
+        summary: &mut MonitorDisconnectSummary,
+    ) -> Result<(), String> {
+        // Enumerate ALL processes; registration is the authorization filter, not a name match.
+        let processes = process_snapshot()?;
+        summary.scanned_processes = processes.len();
+        let entries = std::fs::read_dir(registry)
+            .map_err(|error| format!("读取 Agent 登记目录失败: {error}"))?;
+        for entry in entries {
+            let entry = entry.map_err(|error| format!("读取 Agent 登记项失败: {error}"))?;
+            let name = entry.file_name();
+            let name = name.to_string_lossy();
+            // Ownership, disconnect signals and atomic-write temp files are not Agent markers.
+            if name.starts_with('.') {
+                continue;
+            }
+            let path = entry.path();
+            let load = (|| -> Result<AgentMarker, String> {
+                if path.parent() != Some(registry) {
+                    return Err("Agent 登记路径越界".into());
+                }
+                let metadata =
+                    std::fs::symlink_metadata(&path).map_err(|error| error.to_string())?;
+                if !metadata.is_file()
+                    || metadata_is_link_or_reparse(&metadata)
+                    || metadata.len() >= 4096
+                {
+                    return Err("拒绝异常 Agent 登记文件".into());
+                }
+                let resolved = std::fs::canonicalize(&path).map_err(|error| error.to_string())?;
+                if resolved.parent() != Some(registry) {
+                    return Err("Agent 登记路径越界".into());
+                }
+                use std::io::Read;
+                let mut bytes = Vec::new();
+                std::fs::File::open(&path)
+                    .map_err(|error| error.to_string())?
+                    .take(4096)
+                    .read_to_end(&mut bytes)
+                    .map_err(|error| error.to_string())?;
+                parse_agent_marker(&bytes, &name)
+            })();
+            let marker = match load {
+                Ok(marker) => marker,
+                Err(_) => {
+                    summary.unverified_entries += 1;
+                    continue;
+                }
+            };
+            let Some(&parent_pid) = processes.get(&marker.pid) else {
+                summary.stale_records += 1;
+                continue;
+            };
+            match inspect_and_cleanup(&marker, parent_pid) {
+                Ok(CleanupOutcome::Terminated) => {
+                    summary.orphan_agents_terminated += 1;
+                    log::info!("已终止身份核验通过的残留 Agent: PID={}", marker.pid);
+                }
+                Ok(CleanupOutcome::LiveParent) => summary.live_agents_preserved += 1,
+                Ok(CleanupOutcome::Stale) => summary.stale_records += 1,
+                Ok(CleanupOutcome::Unverified) => summary.unverified_entries += 1,
+                Err(error) => {
+                    log::warn!("残留 Agent {} 未清理: {error}", marker.pid);
+                    summary.failed_pids.push(marker.pid);
+                }
+            }
+        }
+        // Marker files are intentionally retained: cleanup never deletes configuration.
+        Ok(())
+    }
+
+    fn metadata_is_link_or_reparse(metadata: &std::fs::Metadata) -> bool {
+        metadata.file_type().is_symlink()
+            || (metadata.file_attributes() & WINDOWS_FILE_ATTRIBUTE_REPARSE_POINT != 0)
+    }
+
+    fn validate_existing_ancestor_chain(path: &Path) -> Result<(), String> {
+        let mut current = Some(path);
+        while let Some(candidate) = current {
+            match std::fs::symlink_metadata(candidate) {
+                Ok(metadata) => {
+                    if metadata_is_link_or_reparse(&metadata) {
+                        return Err(format!(
+                            "监控通讯停止信号路径不允许符号链接/重解析点 [{}]",
+                            candidate.display()
+                        ));
+                    }
+                    if candidate != path && !metadata.is_dir() {
+                        return Err(format!(
+                            "监控通讯停止信号路径的上级不是普通目录 [{}]",
+                            candidate.display()
+                        ));
+                    }
+                }
+                Err(error) if error.kind() == std::io::ErrorKind::NotFound => {}
+                Err(error) => {
+                    return Err(format!(
+                        "检查监控通讯停止信号路径失败 [{}]: {error}",
+                        candidate.display()
+                    ));
+                }
+            }
+            current = candidate.parent();
+        }
+        Ok(())
+    }
+
+    fn checked_registry_dir() -> Result<PathBuf, String> {
+        let raw_executable = std::env::current_exe()
+            .map_err(|error| format!("获取 DNA Helper 程序路径失败: {error}"))?;
+        let executable_metadata = std::fs::symlink_metadata(&raw_executable).map_err(|error| {
+            format!(
+                "读取 DNA Helper 程序路径失败 [{}]: {error}",
+                raw_executable.display()
+            )
+        })?;
+        if !executable_metadata.is_file() || metadata_is_link_or_reparse(&executable_metadata) {
+            return Err(format!(
+                "拒绝使用异常 DNA Helper 程序路径 [{}]",
+                raw_executable.display()
+            ));
+        }
+
+        let executable = std::fs::canonicalize(&raw_executable).map_err(|error| {
+            format!(
+                "解析 DNA Helper 程序路径失败 [{}]: {error}",
+                raw_executable.display()
+            )
+        })?;
+        let executable_root = executable
+            .parent()
+            .ok_or_else(|| "DNA Helper 程序路径没有上级目录".to_string())?;
+        let raw_config = executable_root.join("config");
+        let raw_registry = raw_config.join("agent-processes");
+        validate_existing_ancestor_chain(&raw_registry)?;
+        std::fs::create_dir_all(&raw_registry).map_err(|error| {
+            format!(
+                "创建监控通讯停止信号目录失败 [{}]: {error}",
+                raw_registry.display()
+            )
+        })?;
+        validate_existing_ancestor_chain(&raw_registry)?;
+
+        let config = std::fs::canonicalize(&raw_config)
+            .map_err(|error| format!("解析 config 目录失败 [{}]: {error}", raw_config.display()))?;
+        let registry = std::fs::canonicalize(&raw_registry).map_err(|error| {
+            format!(
+                "解析监控通讯停止信号目录失败 [{}]: {error}",
+                raw_registry.display()
+            )
+        })?;
+        if config.parent() != Some(executable_root)
+            || config.file_name() != Some(std::ffi::OsStr::new("config"))
+            || registry.parent() != Some(config.as_path())
+            || registry.file_name() != Some(std::ffi::OsStr::new("agent-processes"))
+        {
+            return Err(format!(
+                "拒绝越界监控通讯停止信号目录 [{}]",
+                registry.display()
+            ));
+        }
+        Ok(registry)
+    }
+
+    fn validate_signal_target(path: &Path, registry: &Path) -> Result<(), String> {
+        if path.parent() != Some(registry)
+            || path.file_name() != Some(std::ffi::OsStr::new(".monitor-disconnect.json"))
+        {
+            return Err(format!("拒绝越界监控通讯停止信号 [{}]", path.display()));
+        }
+        match std::fs::symlink_metadata(path) {
+            Ok(metadata) => {
+                if !metadata.is_file() || metadata_is_link_or_reparse(&metadata) {
+                    return Err(format!("拒绝异常监控通讯停止信号 [{}]", path.display()));
+                }
+            }
+            Err(error) if error.kind() == std::io::ErrorKind::NotFound => {}
+            Err(error) => {
+                return Err(format!(
+                    "检查监控通讯停止信号失败 [{}]: {error}",
+                    path.display()
+                ));
+            }
+        }
+        Ok(())
+    }
+
+    fn wide_path(path: &Path) -> Vec<u16> {
+        path.as_os_str().encode_wide().chain(Some(0)).collect()
+    }
+
+    fn replace_signal_file(temporary: &Path, target: &Path) -> Result<(), String> {
+        let temporary_wide = wide_path(temporary);
+        let target_wide = wide_path(target);
+        let replaced = unsafe {
+            MoveFileExW(
+                temporary_wide.as_ptr(),
+                target_wide.as_ptr(),
+                MOVEFILE_REPLACE_EXISTING | MOVEFILE_WRITE_THROUGH,
+            )
+        };
+        if replaced == 0 {
+            return Err(format!(
+                "发布监控通讯停止信号失败: {}",
+                std::io::Error::last_os_error()
+            ));
+        }
+        Ok(())
+    }
+
+    fn write_signal(registry: &Path, signal: &MonitorDisconnectSignal) -> Result<(), String> {
+        let bytes = serde_json::to_vec(signal)
+            .map_err(|error| format!("生成监控通讯停止信号失败: {error}"))?;
+        parse_monitor_disconnect_signal(&bytes)?;
+        let target = registry.join(".monitor-disconnect.json");
+        validate_signal_target(&target, registry)?;
+
+        let sequence = SIGNAL_SEQUENCE.fetch_add(1, Ordering::Relaxed);
+        let temporary = registry.join(format!(
+            ".tmp-monitor-disconnect-{}-{sequence}.json",
+            std::process::id()
+        ));
+        let write_result = (|| -> Result<(), String> {
+            let mut file = OpenOptions::new()
+                .write(true)
+                .create_new(true)
+                .open(&temporary)
+                .map_err(|error| {
+                    format!(
+                        "创建临时监控通讯停止信号失败 [{}]: {error}",
+                        temporary.display()
+                    )
+                })?;
+            file.write_all(&bytes)
+                .and_then(|_| file.sync_all())
+                .map_err(|error| format!("写入监控通讯停止信号失败: {error}"))?;
+            drop(file);
+            validate_signal_target(&target, registry)?;
+            replace_signal_file(&temporary, &target)?;
+            let metadata = std::fs::symlink_metadata(&target)
+                .map_err(|error| format!("重新检查监控通讯停止信号失败: {error}"))?;
+            if !metadata.is_file() || metadata_is_link_or_reparse(&metadata) {
+                return Err("发布后的监控通讯停止信号不是普通文件".to_string());
+            }
+            let resolved = std::fs::canonicalize(&target)
+                .map_err(|error| format!("解析监控通讯停止信号失败: {error}"))?;
+            if resolved.parent() != Some(registry) {
+                return Err(format!(
+                    "发布后的监控通讯停止信号越界 [{}]",
+                    resolved.display()
+                ));
+            }
+            Ok(())
+        })();
+        if write_result.is_err() {
+            let _ = std::fs::remove_file(&temporary);
+        }
+        write_result
+    }
+
+    pub(super) fn disconnect_all_dna_helper_monitors_windows(
+    ) -> Result<MonitorDisconnectSummary, String> {
+        let registry = checked_registry_dir()?;
+        let now = SystemTime::now()
+            .duration_since(UNIX_EPOCH)
+            .map_err(|error| format!("读取系统时间失败: {error}"))?;
+        let sequence = SIGNAL_SEQUENCE.fetch_add(1, Ordering::Relaxed);
+        let generation = format!(
+            "settings-{}-{}-{sequence}",
+            std::process::id(),
+            now.as_nanos()
+        );
+        let signal = MonitorDisconnectSignal {
+            schema_version: MONITOR_DISCONNECT_SCHEMA_VERSION,
+            generation: generation.clone(),
+            created_at_unix_ms: u64::try_from(now.as_millis())
+                .map_err(|_| "系统时间超出监控信号范围".to_string())?,
+            source: "settings".to_string(),
+        };
+        let signal_error = write_signal(&registry, &signal).err();
+        let mut summary = MonitorDisconnectSummary {
+            generation: if signal_error.is_none() {
+                Some(generation)
+            } else {
+                None
+            },
+            signal_error,
+            scan_error: None,
+            scanned_processes: 0,
+            orphan_agents_terminated: 0,
+            live_agents_preserved: 0,
+            stale_records: 0,
+            unverified_entries: 0,
+            failed_pids: Vec::new(),
+        };
+        summary.scan_error = cleanup_registered_orphans(&registry, &mut summary).err();
+        Ok(summary)
+    }
+
+    #[cfg(test)]
+    mod cleanup_tests {
+        use super::*;
+        use std::os::windows::process::CommandExt;
+        use std::process::{Child, Command, Stdio};
+
+        struct TestChild(Child);
+        impl Drop for TestChild {
+            fn drop(&mut self) {
+                let _ = self.0.kill();
+                let _ = self.0.wait();
+            }
+        }
+
+        fn spawn_child() -> TestChild {
+            TestChild(
+                Command::new("python")
+                    .args(["-c", "import time; time.sleep(60)"])
+                    .creation_flags(0x08000000)
+                    .stdin(Stdio::null())
+                    .stdout(Stdio::null())
+                    .stderr(Stdio::null())
+                    .spawn()
+                    .expect("test Python child"),
+            )
+        }
+
+        fn marker_for(pid: u32) -> AgentMarker {
+            let handle = open_process(pid, false).unwrap();
+            AgentMarker {
+                schema_version: 1,
+                pid,
+                creation_time_100ns: creation_time(&handle).unwrap(),
+                executable_path: executable_path(&handle)
+                    .unwrap()
+                    .to_string_lossy()
+                    .into_owned(),
+            }
+        }
+
+        #[test]
+        fn cleanup_preserves_live_parent_and_rejects_reused_pid_and_wrong_path() {
+            let child = spawn_child();
+            let marker = marker_for(child.0.id());
+            let parent = std::process::id();
+            assert_eq!(
+                inspect_and_cleanup(&marker, parent).unwrap(),
+                CleanupOutcome::LiveParent
+            );
+            let mut wrong_time = marker.clone();
+            wrong_time.creation_time_100ns += 1;
+            assert_eq!(
+                inspect_and_cleanup(&wrong_time, parent).unwrap(),
+                CleanupOutcome::Unverified
+            );
+            let mut wrong_path = marker.clone();
+            wrong_path.executable_path = std::env::current_exe()
+                .unwrap()
+                .to_string_lossy()
+                .into_owned();
+            assert_eq!(
+                inspect_and_cleanup(&wrong_path, parent).unwrap(),
+                CleanupOutcome::Unverified
+            );
+            assert_eq!(
+                inspect_and_cleanup(&marker, 0).unwrap(),
+                CleanupOutcome::Unverified
+            );
+            assert_eq!(
+                unsafe { WaitForSingleObject(open_process(marker.pid, false).unwrap().0, 0) },
+                WAIT_TIMEOUT
+            );
+        }
+
+        #[test]
+        fn cleanup_terminates_only_its_own_verified_orphan_fixture() {
+            // The intermediate parent exits; only this test-created orphan may be killed.
+            let output = Command::new("python").args(["-c",
+                "import subprocess,sys; p=subprocess.Popen([sys.executable,'-c','import time; time.sleep(60)'],stdin=subprocess.DEVNULL,stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL,creationflags=0x08000000); print(p.pid)"])
+                .creation_flags(0x08000000).output().unwrap();
+            assert!(output.status.success());
+            let pid: u32 = String::from_utf8(output.stdout)
+                .unwrap()
+                .trim()
+                .parse()
+                .unwrap();
+            let target = open_process(pid, true).unwrap();
+            // The guard owns only the test fixture's concrete handle, never a reused PID.
+            struct OrphanGuard(OwnedHandle);
+            impl Drop for OrphanGuard {
+                fn drop(&mut self) {
+                    unsafe {
+                        TerminateProcess(self.0 .0, 0);
+                        WaitForSingleObject(self.0 .0, 2000);
+                    }
+                }
+            }
+            let guard = OrphanGuard(target);
+            let marker = marker_for(pid);
+            let parent_pid = process_snapshot().unwrap()[&pid];
+            assert_eq!(
+                inspect_and_cleanup(&marker, parent_pid).unwrap(),
+                CleanupOutcome::Terminated
+            );
+            assert_eq!(unsafe { WaitForSingleObject(guard.0 .0, 0) }, WAIT_OBJECT_0);
+            assert_eq!(
+                inspect_and_cleanup(&marker, parent_pid).unwrap(),
+                CleanupOutcome::Stale
+            );
+        }
+
+        #[test]
+        fn snapshot_includes_current_process_and_unknown_parent_is_not_orphan() {
+            assert!(process_snapshot()
+                .unwrap()
+                .contains_key(&std::process::id()));
+            assert!(parent_is_gone(0, 1).is_err());
+            let this = open_process(std::process::id(), false).unwrap();
+            let created = creation_time(&this).unwrap();
+            assert!(!parent_is_gone(std::process::id(), created).unwrap());
+            assert!(parent_is_gone(std::process::id(), created - 1).unwrap());
+        }
+
+        #[test]
+        fn scan_ignores_unregistered_processes_and_rejects_bad_registry_entries() {
+            let registered = spawn_child();
+            let unrelated = spawn_child();
+            let marker = marker_for(registered.0.id());
+            let root = std::env::temp_dir().join(format!(
+                "dna-cleanup-test-{}-{}",
+                std::process::id(),
+                SystemTime::now()
+                    .duration_since(UNIX_EPOCH)
+                    .unwrap()
+                    .as_nanos()
+            ));
+            std::fs::create_dir(&root).unwrap();
+            let root = std::fs::canonicalize(root).unwrap();
+            let marker_path = root.join(format!("{}.json", marker.pid));
+            std::fs::write(&marker_path, serde_json::to_vec(&marker).unwrap()).unwrap();
+            std::fs::write(root.join("invalid.json"), b"not JSON").unwrap();
+            std::fs::create_dir(root.join("directory.json")).unwrap();
+            let stale = AgentMarker {
+                pid: u32::MAX,
+                ..marker.clone()
+            };
+            let stale_path = root.join(format!("{}.json", stale.pid));
+            std::fs::write(&stale_path, serde_json::to_vec(&stale).unwrap()).unwrap();
+            let link = root.join("link.json");
+            let linked = std::os::windows::fs::symlink_file(&marker_path, &link).is_ok();
+            let mut summary = MonitorDisconnectSummary::default();
+            cleanup_registered_orphans(&root, &mut summary).unwrap();
+            assert!(summary.scanned_processes > 0);
+            assert_eq!(summary.orphan_agents_terminated, 0);
+            assert_eq!(summary.live_agents_preserved, 1);
+            assert_eq!(summary.stale_records, 1);
+            assert_eq!(summary.unverified_entries, if linked { 3 } else { 2 });
+            assert!(summary.failed_pids.is_empty());
+            assert_eq!(
+                unsafe { WaitForSingleObject(open_process(unrelated.0.id(), false).unwrap().0, 0) },
+                WAIT_TIMEOUT
+            );
+            assert!(marker_path.is_file()); // Cleanup does not delete configuration.
+            if linked {
+                std::fs::remove_file(link).unwrap();
+            }
+            std::fs::remove_file(marker_path).unwrap();
+            std::fs::remove_file(stale_path).unwrap();
+            std::fs::remove_file(root.join("invalid.json")).unwrap();
+            std::fs::remove_dir(root.join("directory.json")).unwrap();
+            std::fs::remove_dir(root).unwrap();
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[cfg(windows)]
+    #[test]
+    fn agent_marker_requires_exact_identity_schema_and_python_executable() {
+        let marker = serde_json::json!({"schema_version": 1, "pid": 123,
+            "creation_time_100ns": 100, "executable_path": "C:\\Python\\python.exe"});
+        let bytes = serde_json::to_vec(&marker).unwrap();
+        assert!(parse_agent_marker(&bytes, "123.json").is_ok());
+        for name in [
+            "124.json",
+            "0123.json",
+            "../123.json",
+            ".telegram-owner.json",
+        ] {
+            assert!(parse_agent_marker(&bytes, name).is_err());
+        }
+        for (key, bad) in [
+            ("schema_version", serde_json::json!(2)),
+            ("pid", serde_json::json!(0)),
+            ("creation_time_100ns", serde_json::json!(0)),
+            ("unexpected", serde_json::json!(true)),
+            ("executable_path", serde_json::json!("python.exe")),
+            ("executable_path", serde_json::json!("C:\\Games\\game.exe")),
+        ] {
+            let mut invalid = marker.clone();
+            invalid[key] = bad;
+            assert!(
+                parse_agent_marker(&serde_json::to_vec(&invalid).unwrap(), "123.json").is_err()
+            );
+        }
+        assert!(parse_agent_marker(&vec![b' '; 4096], "123.json").is_err());
+        assert!(parse_agent_marker(b"", "123.json").is_err());
+    }
+
+    #[test]
+    fn signal_parser_rejects_unknown_fields_and_invalid_source() {
+        let unknown = br#"{
+            "schema_version": 1,
+            "generation": "settings-1",
+            "created_at_unix_ms": 1,
+            "source": "settings",
+            "unexpected": true
+        }"#;
+        assert!(parse_monitor_disconnect_signal(unknown).is_err());
+
+        let invalid_source = br#"{
+            "schema_version": 1,
+            "generation": "settings-1",
+            "created_at_unix_ms": 1,
+            "source": "other"
+        }"#;
+        assert!(parse_monitor_disconnect_signal(invalid_source).is_err());
+    }
+
+    #[test]
+    fn disconnect_summary_serializes_with_camel_case_fields() {
+        let summary = MonitorDisconnectSummary {
+            generation: Some("settings-1".to_string()),
+            signal_error: None,
+            scan_error: None,
+            scanned_processes: 100,
+            orphan_agents_terminated: 2,
+            live_agents_preserved: 1,
+            stale_records: 3,
+            unverified_entries: 0,
+            failed_pids: vec![42],
+        };
+        assert_eq!(
+            serde_json::to_value(summary).unwrap(),
+            serde_json::json!({"generation": "settings-1", "signalError": null, "scanError": null,
+                "scannedProcesses": 100, "orphanAgentsTerminated": 2, "liveAgentsPreserved": 1,
+                "staleRecords": 3, "unverifiedEntries": 0, "failedPids": [42]})
+        );
+    }
+}
