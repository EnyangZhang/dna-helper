+mod debug_cleanup_tests {
+    use super::*;
+
+    fn test_debug_dir(name: &str) -> PathBuf {
+        let unique = SystemTime::now()
+            .duration_since(SystemTime::UNIX_EPOCH)
+            .expect("system clock before epoch")
+            .as_nanos();
+        let path = std::env::temp_dir().join(format!(
+            "mxu-debug-cleanup-{}-{}-{}",
+            name,
+            std::process::id(),
+            unique
+        ));
+        std::fs::create_dir(&path).expect("create isolated test debug dir");
+        std::fs::canonicalize(path).expect("canonicalize isolated test debug dir")
+    }
+
+    #[test]
+    fn full_clear_removes_nested_files_and_directories() {
+        let root = test_debug_dir("full-clear");
+        let nested = root.join("logs").join("nested");
+        std::fs::create_dir_all(&nested).expect("create nested directory");
+        std::fs::write(root.join("root.log"), b"root").expect("write root log");
+        std::fs::write(nested.join("image.png"), b"image").expect("write nested file");
+
+        assert_eq!(
+            clear_debug_entries_in(&root).expect("clear test directory"),
+            2
+        );
+        assert_eq!(
+            std::fs::read_dir(&root)
+                .expect("read cleared directory")
+                .count(),
+            0
+        );
+
+        std::fs::remove_dir(&root).expect("remove isolated test directory");
+    }
+
+    #[test]
+    fn retention_range_is_strictly_seven_through_fourteen_days() {
+        let root = test_debug_dir("retention-range");
+        let now = SystemTime::now();
+
+        assert!(cleanup_old_debug_entries_in(&root, 6, now).is_err());
+        assert_eq!(cleanup_old_debug_entries_in(&root, 7, now).unwrap(), 0);
+        assert_eq!(cleanup_old_debug_entries_in(&root, 14, now).unwrap(), 0);
+        assert!(cleanup_old_debug_entries_in(&root, 15, now).is_err());
+
+        std::fs::remove_dir(&root).expect("remove isolated test directory");
+    }
+
+    #[cfg(windows)]
+    #[test]
+    fn collection_rejects_symlinks_when_creation_is_permitted() {
+        use std::os::windows::fs::symlink_file;
+
+        let root = test_debug_dir("symlink");
+        let outside = root.parent().expect("test root parent").join(format!(
+            "mxu-outside-{}-{}.log",
+            std::process::id(),
+            root.file_name().unwrap().to_string_lossy()
+        ));
+        std::fs::write(&outside, b"outside").expect("write outside sentinel");
+        let link = root.join("escape.log");
+
+        if symlink_file(&outside, &link).is_ok() {
+            let error = collect_checked_debug_entries(&root).expect_err("symlink must be rejected");
+            assert!(error.contains("符号链接") || error.contains("重解析点"));
+            std::fs::remove_file(&link).expect("remove test symlink");
+        }
+
+        std::fs::remove_file(&outside).expect("remove outside sentinel");
+        std::fs::remove_dir(&root).expect("remove isolated test directory");
+    }
+}
