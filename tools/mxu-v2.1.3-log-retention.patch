+/// 删除 debug 内修改时间超过 7～14 天的文件，并清理由此产生的空目录。
+#[tauri::command]
+pub fn cleanup_old_debug_entries(retention_days: u64) -> Result<u64, String> {
+    let Some(debug_dir) = checked_debug_dir(false)? else {
+        return Ok(0);
+    };
+    cleanup_old_debug_entries_in(&debug_dir, retention_days, SystemTime::now())
+}
+
+fn cleanup_old_debug_entries_in(
+    debug_dir: &Path,
+    retention_days: u64,
+    now: SystemTime,
+) -> Result<u64, String> {
+    if !(7..=14).contains(&retention_days) {
+        return Err("日志保留天数必须在 7 到 14 天之间".to_string());
+    }
+
+    let entries = collect_checked_debug_entries(debug_dir)?;
+    let retention = Duration::from_secs(retention_days.saturating_mul(24 * 60 * 60));
+    let cutoff = now
+        .checked_sub(retention)
+        .ok_or_else(|| "计算日志保留时间失败".to_string())?;
+    let mut deleted = 0_u64;
+
+    for entry in entries {
+        if entry.is_dir {
+            let mut children = std::fs::read_dir(&entry.path)
+                .map_err(|e| format!("检查日志目录失败 [{}]: {}", entry.path.display(), e))?;
+            if children.next().is_none() {
+                std::fs::remove_dir(&entry.path)
+                    .map_err(|e| format!("删除空日志目录失败 [{}]: {}", entry.path.display(), e))?;
+            }
+            continue;
+        }
+
+        let Some(modified) = entry.modified else {
+            return Err(format!("无法读取日志修改时间 [{}]", entry.path.display()));
+        };
+        if modified <= cutoff {
+            std::fs::remove_file(&entry.path)
+                .map_err(|e| format!("删除旧日志失败 [{}]: {}", entry.path.display(), e))?;
+            deleted = deleted.saturating_add(1);
+        }
+    }
+
+    Ok(deleted)
+}
+
+fn clear_debug_directory() -> Result<u64, String> {
+    let Some(debug_dir) = checked_debug_dir(false)? else {
+        return Ok(0);
+    };
+    clear_debug_entries_in(&debug_dir)
+}
+
+fn clear_debug_entries_in(debug_dir: &Path) -> Result<u64, String> {
+    let entries = collect_checked_debug_entries(debug_dir)?;
+    let mut deleted = 0_u64;
+
+    for entry in entries {
+        if entry.is_dir {
+            std::fs::remove_dir(&entry.path)
+                .map_err(|e| format!("删除日志目录失败 [{}]: {}", entry.path.display(), e))?;
+        } else {
+            std::fs::remove_file(&entry.path)
+                .map_err(|e| format!("删除日志文件失败 [{}]: {}", entry.path.display(), e))?;
+            deleted = deleted.saturating_add(1);
         }
     }
 
     Ok(deleted)
 }
 
+/// 在 debug 目录内创建一次性标记；应用下次启动、日志初始化前执行完整清理。
+#[tauri::command]
+pub fn schedule_full_debug_clear() -> Result<(), String> {
+    let debug_dir = checked_debug_dir(true)?.ok_or_else(|| "无法创建日志目录".to_string())?;
+    let marker = debug_dir.join(DEBUG_CLEAR_MARKER);
+
+    if marker.exists() {
+        let metadata = std::fs::symlink_metadata(&marker)
+            .map_err(|e| format!("读取清理标记失败 [{}]: {}", marker.display(), e))?;
+        if !metadata.is_file() || metadata_is_link_or_reparse(&metadata) {
+            return Err(format!("拒绝覆盖异常清理标记 [{}]", marker.display()));
+        }
+    }
+
+    std::fs::write(&marker, b"clear debug directory on next start\n")
+        .map_err(|e| format!("写入清理标记失败 [{}]: {}", marker.display(), e))
+}
+
+/// 必须在任何日志文件被打开前调用。
