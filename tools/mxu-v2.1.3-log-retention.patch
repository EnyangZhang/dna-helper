+fn checked_debug_dir(create: bool) -> Result<Option<PathBuf>, String> {
+    let raw_exe_dir = get_exe_directory()?;
+    let exe_metadata = std::fs::symlink_metadata(&raw_exe_dir)
+        .map_err(|e| format!("读取程序目录失败 [{}]: {}", raw_exe_dir.display(), e))?;
+    if !exe_metadata.is_dir() || metadata_is_link_or_reparse(&exe_metadata) {
+        return Err(format!(
+            "拒绝使用符号链接或重解析点程序目录 [{}]",
+            raw_exe_dir.display()
+        ));
+    }
+
+    let exe_dir = std::fs::canonicalize(&raw_exe_dir)
+        .map_err(|e| format!("解析程序目录失败 [{}]: {}", raw_exe_dir.display(), e))?;
+    let debug_dir = exe_dir.join("debug");
+
+    if !debug_dir.exists() {
+        if !create {
+            return Ok(None);
+        }
+        std::fs::create_dir(&debug_dir)
+            .map_err(|e| format!("创建日志目录失败 [{}]: {}", debug_dir.display(), e))?;
+    }
+
+    let debug_metadata = std::fs::symlink_metadata(&debug_dir)
+        .map_err(|e| format!("读取日志目录失败 [{}]: {}", debug_dir.display(), e))?;
+    if !debug_metadata.is_dir() || metadata_is_link_or_reparse(&debug_metadata) {
+        return Err(format!(
+            "拒绝使用符号链接、重解析点或非目录日志路径 [{}]",
+            debug_dir.display()
+        ));
+    }
+
+    let resolved_debug = std::fs::canonicalize(&debug_dir)
+        .map_err(|e| format!("解析日志目录失败 [{}]: {}", debug_dir.display(), e))?;
+    if resolved_debug.parent() != Some(exe_dir.as_path())
+        || resolved_debug.file_name() != Some(std::ffi::OsStr::new("debug"))
+    {
+        return Err(format!("拒绝越界日志目录 [{}]", resolved_debug.display()));
+    }
+
+    Ok(Some(resolved_debug))
+}
+
+fn collect_checked_debug_entries(root: &Path) -> Result<Vec<CheckedDebugEntry>, String> {
+    fn visit(root: &Path, dir: &Path, entries: &mut Vec<CheckedDebugEntry>) -> Result<(), String> {
+        let children = std::fs::read_dir(dir)
+            .map_err(|e| format!("读取日志目录失败 [{}]: {}", dir.display(), e))?;
+
+        for child in children {
+            let child = child.map_err(|e| format!("读取日志目录项失败: {}", e))?;
+            let path = child.path();
+            let metadata = std::fs::symlink_metadata(&path)
+                .map_err(|e| format!("读取日志路径失败 [{}]: {}", path.display(), e))?;
+            if metadata_is_link_or_reparse(&metadata) {
+                return Err(format!("拒绝删除符号链接或重解析点 [{}]", path.display()));
+            }
+
+            let resolved = std::fs::canonicalize(&path)
+                .map_err(|e| format!("解析日志路径失败 [{}]: {}", path.display(), e))?;
+            if resolved == root || !resolved.starts_with(root) {
+                return Err(format!("拒绝删除越界路径 [{}]", resolved.display()));
+            }
+
+            if metadata.is_dir() {
+                visit(root, &resolved, entries)?;
+                entries.push(CheckedDebugEntry {
+                    path: resolved,
+                    is_dir: true,
+                    modified: metadata.modified().ok(),
+                });
+            } else if metadata.is_file() {
+                entries.push(CheckedDebugEntry {
+                    path: resolved,
+                    is_dir: false,
+                    modified: metadata.modified().ok(),
+                });
+            } else {
+                return Err(format!("拒绝删除非普通日志路径 [{}]", path.display()));
+            }
+        }
+
+        Ok(())
+    }
+
+    let mut entries = Vec::new();
+    visit(root, root, &mut entries)?;
+    Ok(entries)
+}
