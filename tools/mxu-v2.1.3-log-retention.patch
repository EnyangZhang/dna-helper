+/// Terminate all registered DNA Helper Agents and all sibling DNA Helper UI
+/// processes. The current UI is deliberately left alive so the frontend can
+/// exit it only after this command returns successfully.
+#[tauri::command]
+pub fn terminate_all_dna_helper_processes() -> Result<ProcessTerminationSummary, String> {
+    #[cfg(windows)]
+    {
+        return windows_impl::terminate_all_dna_helper_processes_windows();
+    }
+
+    #[cfg(not(windows))]
+    {
+        Err("关闭所有 DNA Helper 进程仅支持 Windows".to_string())
+    }
+}
