+
+    const WINDOWS_FILE_ATTRIBUTE_REPARSE_POINT: u32 = 0x400;
+    const ERROR_NO_MORE_FILES: i32 = 18;
+    const TERMINATION_WAIT_MS: u32 = 2000;
+    const TH32CS_SNAPPROCESS: u32 = 0x0000_0002;
+    const PROCESS_TERMINATE: u32 = 0x0001;
+    const SYNCHRONIZE: u32 = 0x0010_0000;
+    const PROCESS_QUERY_LIMITED_INFORMATION: u32 = 0x1000;
+    const WAIT_OBJECT_0: u32 = 0x0000_0000;
+    const WAIT_TIMEOUT: u32 = 0x0000_0102;
+    const INVALID_HANDLE_VALUE: Handle = -1_isize as Handle;
+
+    struct OwnedHandle(Handle);
+
+    impl Drop for OwnedHandle {
+        fn drop(&mut self) {
+            if !self.0.is_null() && self.0 != INVALID_HANDLE_VALUE {
+                unsafe {
+                    CloseHandle(self.0);
+                }
+            }
+        }
+    }
+
+    fn metadata_is_link_or_reparse(metadata: &std::fs::Metadata) -> bool {
+        metadata.file_type().is_symlink()
+            || metadata.file_attributes() & WINDOWS_FILE_ATTRIBUTE_REPARSE_POINT != 0
+    }
+
+    fn validate_existing_ancestor_chain(path: &Path) -> Result<(), String> {
+        let mut current = Some(path);
+        while let Some(candidate) = current {
+            match std::fs::symlink_metadata(candidate) {
+                Ok(metadata) => {
+                    if metadata_is_link_or_reparse(&metadata) {
+                        return Err(format!(
+                            "Agent marker 路径不允许符号链接或重解析点 [{}]",
+                            candidate.display()
+                        ));
+                    }
+                    if candidate != path && !metadata.is_dir() {
+                        return Err(format!(
+                            "Agent marker 路径的上级不是普通目录 [{}]",
+                            candidate.display()
+                        ));
+                    }
+                }
+                Err(error) if error.kind() == std::io::ErrorKind::NotFound => {}
+                Err(error) => {
+                    return Err(format!(
+                        "检查 Agent marker 路径失败 [{}]: {error}",
+                        candidate.display()
+                    ));
+                }
+            }
+            current = candidate.parent();
+        }
+        Ok(())
+    }
+
+    fn checked_registry_dir() -> Result<Option<PathBuf>, String> {
+        let raw_executable = std::env::current_exe()
+            .map_err(|error| format!("获取 DNA Helper 程序路径失败: {error}"))?;
+        let executable_metadata = std::fs::symlink_metadata(&raw_executable).map_err(|error| {
+            format!(
+                "读取 DNA Helper 程序路径失败 [{}]: {error}",
+                raw_executable.display()
+            )
+        })?;
+        if !executable_metadata.is_file() || metadata_is_link_or_reparse(&executable_metadata) {
+            return Err(format!(
+                "拒绝使用异常 DNA Helper 程序路径 [{}]",
+                raw_executable.display()
+            ));
+        }
+
+        let executable = std::fs::canonicalize(&raw_executable).map_err(|error| {
+            format!(
+                "解析 DNA Helper 程序路径失败 [{}]: {error}",
+                raw_executable.display()
+            )
+        })?;
+        let executable_root = executable
+            .parent()
+            .ok_or_else(|| "DNA Helper 程序路径没有上级目录".to_string())?;
+        let raw_registry = executable_root.join("config").join("agent-processes");
+        validate_existing_ancestor_chain(&raw_registry)?;
+
+        let registry_metadata = match std::fs::symlink_metadata(&raw_registry) {
+            Ok(metadata) => metadata,
+            Err(error) if error.kind() == std::io::ErrorKind::NotFound => return Ok(None),
+            Err(error) => {
+                return Err(format!(
+                    "读取 Agent marker 目录失败 [{}]: {error}",
+                    raw_registry.display()
+                ));
+            }
+        };
+        if !registry_metadata.is_dir() || metadata_is_link_or_reparse(&registry_metadata) {
+            return Err(format!(
+                "拒绝使用异常 Agent marker 目录 [{}]",
+                raw_registry.display()
+            ));
+        }
+
+        let registry = std::fs::canonicalize(&raw_registry).map_err(|error| {
+            format!(
+                "解析 Agent marker 目录失败 [{}]: {error}",
+                raw_registry.display()
+            )
+        })?;
+        let expected_parent = executable_root.join("config");
+        let resolved_parent = std::fs::canonicalize(&expected_parent).map_err(|error| {
+            format!(
+                "解析 Agent marker 上级目录失败 [{}]: {error}",
+                expected_parent.display()
+            )
+        })?;
+        if registry.parent() != Some(resolved_parent.as_path())
+            || registry.file_name() != Some(std::ffi::OsStr::new("agent-processes"))
+        {
+            return Err(format!(
+                "拒绝越界 Agent marker 目录 [{}]",
+                registry.display()
+            ));
+        }
+        Ok(Some(registry))
+    }
+
+    fn checked_marker_paths(registry: &Path) -> Result<Vec<(u32, PathBuf)>, String> {
+        let mut paths = Vec::new();
+        for entry in std::fs::read_dir(registry)
+            .map_err(|error| format!("读取 Agent marker 目录失败: {error}"))?
+        {
+            let entry = entry.map_err(|error| format!("读取 Agent marker 目录项失败: {error}"))?;
+            if paths.len() >= MAX_PROCESS_MARKERS {
+                return Err(format!(
+                    "Agent marker 数量超过安全上限 {MAX_PROCESS_MARKERS}"
+                ));
+            }
+            let path = entry.path();
+            let metadata = std::fs::symlink_metadata(&path)
+                .map_err(|error| format!("读取 Agent marker 失败 [{}]: {error}", path.display()))?;
+            if !metadata.is_file() || metadata_is_link_or_reparse(&metadata) {
+                return Err(format!("拒绝异常 Agent marker [{}]", path.display()));
+            }
+            if metadata.len() == 0 || metadata.len() >= MAX_MARKER_BYTES {
+                return Err(format!(
+                    "Agent marker 大小无效 [{}]: {} bytes",
+                    path.display(),
+                    metadata.len()
+                ));
+            }
+
+            let file_name = path
+                .file_name()
+                .and_then(|value| value.to_str())
+                .ok_or_else(|| format!("Agent marker 文件名无效 [{}]", path.display()))?;
+            let pid_text = file_name
+                .strip_suffix(".json")
+                .ok_or_else(|| format!("Agent marker 扩展名无效 [{}]", path.display()))?;
+            if pid_text.is_empty() || !pid_text.bytes().all(|byte| byte.is_ascii_digit()) {
+                return Err(format!("Agent marker 文件名无效 [{}]", path.display()));
+            }
+            let pid = pid_text
+                .parse::<u32>()
+                .map_err(|_| format!("Agent marker PID 无效 [{}]", path.display()))?;
+            if pid == 0 || format!("{pid}.json") != file_name {
+                return Err(format!(
+                    "Agent marker 文件名不是规范 PID [{}]",
+                    path.display()
+                ));
+            }
+
+            let resolved = std::fs::canonicalize(&path)
+                .map_err(|error| format!("解析 Agent marker 失败 [{}]: {error}", path.display()))?;
+            if resolved.parent() != Some(registry) {
+                return Err(format!("拒绝越界 Agent marker [{}]", resolved.display()));
+            }
+            paths.push((pid, resolved));
+        }
+        Ok(paths)
+    }
+
+    fn read_marker(path: &Path, file_pid: u32) -> Result<ProcessMarker, String> {
+        let mut file = File::open(path)
+            .map_err(|error| format!("打开 Agent marker 失败 [{}]: {error}", path.display()))?;
+        let mut bytes = Vec::new();
+        file.by_ref()
+            .take(MAX_MARKER_BYTES)
+            .read_to_end(&mut bytes)
+            .map_err(|error| format!("读取 Agent marker 失败 [{}]: {error}", path.display()))?;
+        parse_process_marker(&bytes, file_pid)
+    }
+
+    fn remove_marker(path: &Path, registry: &Path) -> Result<(), String> {
+        let metadata = std::fs::symlink_metadata(path)
+            .map_err(|error| format!("重新检查 Agent marker 失败 [{}]: {error}", path.display()))?;
+        if !metadata.is_file() || metadata_is_link_or_reparse(&metadata) {
+            return Err(format!("拒绝删除异常 Agent marker [{}]", path.display()));
+        }
+        let resolved = std::fs::canonicalize(path)
+            .map_err(|error| format!("重新解析 Agent marker 失败 [{}]: {error}", path.display()))?;
+        if resolved.parent() != Some(registry) {
+            return Err(format!(
+                "拒绝删除越界 Agent marker [{}]",
+                resolved.display()
+            ));
+        }
+        std::fs::remove_file(&resolved)
+            .map_err(|error| format!("删除 Agent marker 失败 [{}]: {error}", resolved.display()))
+    }
+
+    fn process_ids() -> Result<HashSet<u32>, String> {
+        let raw_snapshot = unsafe { CreateToolhelp32Snapshot(TH32CS_SNAPPROCESS, 0) };
+        if raw_snapshot == INVALID_HANDLE_VALUE {
+            return Err(format!(
+                "枚举 Windows 进程失败: {}",
+                std::io::Error::last_os_error()
+            ));
+        }
+        let snapshot = OwnedHandle(raw_snapshot);
+        let mut entry: ProcessEntry32W = unsafe { std::mem::zeroed() };
+        entry.dw_size = std::mem::size_of::<ProcessEntry32W>() as u32;
+        if unsafe { Process32FirstW(snapshot.0, &mut entry) } == 0 {
+            return Err(format!(
+                "读取 Windows 进程快照失败: {}",
+                std::io::Error::last_os_error()
+            ));
+        }
+
+        let mut pids = HashSet::new();
+        loop {
+            if entry.th32_process_id != 0 {
+                pids.insert(entry.th32_process_id);
+            }
+            if unsafe { Process32NextW(snapshot.0, &mut entry) } == 0 {
+                let error = std::io::Error::last_os_error();
+                if error.raw_os_error() != Some(ERROR_NO_MORE_FILES) {
+                    return Err(format!("继续读取 Windows 进程快照失败: {error}"));
+                }
+                break;
+            }
+        }
+        Ok(pids)
+    }
+
+    fn open_terminable_process(pid: u32) -> Result<OwnedHandle, String> {
+        let access = PROCESS_QUERY_LIMITED_INFORMATION | PROCESS_TERMINATE | SYNCHRONIZE;
+        let raw_handle = unsafe { OpenProcess(access, 0, pid) };
+        if raw_handle.is_null() {
+            return Err(format!(
+                "打开进程 PID {pid} 失败: {}",
+                std::io::Error::last_os_error()
+            ));
+        }
+        Ok(OwnedHandle(raw_handle))
+    }
+
+    fn process_has_exited(handle: &OwnedHandle) -> Result<bool, String> {
+        match unsafe { WaitForSingleObject(handle.0, 0) } {
+            WAIT_OBJECT_0 => Ok(true),
+            WAIT_TIMEOUT => Ok(false),
+            value => Err(format!("检查进程状态失败: WaitForSingleObject={value:#x}")),
+        }
+    }
+
+    fn process_creation_time(handle: &OwnedHandle) -> Result<u64, String> {
+        let mut creation: FileTime = unsafe { std::mem::zeroed() };
+        let mut exit_time: FileTime = unsafe { std::mem::zeroed() };
+        let mut kernel_time: FileTime = unsafe { std::mem::zeroed() };
+        let mut user_time: FileTime = unsafe { std::mem::zeroed() };
+        if unsafe {
+            GetProcessTimes(
+                handle.0,
+                &mut creation,
+                &mut exit_time,
+                &mut kernel_time,
+                &mut user_time,
+            )
+        } == 0
+        {
+            return Err(format!(
+                "读取进程创建时间失败: {}",
+                std::io::Error::last_os_error()
+            ));
+        }
+        Ok((u64::from(creation.dw_high_date_time) << 32) | u64::from(creation.dw_low_date_time))
+    }
+
+    fn process_executable_path(handle: &OwnedHandle) -> Result<PathBuf, String> {
+        let mut buffer = vec![0_u16; 32_768];
+        let mut length = buffer.len() as u32;
+        if unsafe { QueryFullProcessImageNameW(handle.0, 0, buffer.as_mut_ptr(), &mut length) } == 0
+        {
+            return Err(format!(
+                "读取进程可执行文件路径失败: {}",
+                std::io::Error::last_os_error()
+            ));
+        }
+        buffer.truncate(length as usize);
+        Ok(PathBuf::from(OsString::from_wide(&buffer)))
+    }
+
+    fn canonical_process_path(path: &Path, pid: u32) -> Result<PathBuf, String> {
+        let metadata = std::fs::symlink_metadata(path).map_err(|error| {
+            format!(
+                "检查 PID {pid} 的可执行文件路径失败 [{}]: {error}",
+                path.display()
+            )
+        })?;
+        if !metadata.is_file() || metadata_is_link_or_reparse(&metadata) {
+            return Err(format!(
+                "拒绝 PID {pid} 的异常可执行文件路径 [{}]",
+                path.display()
+            ));
+        }
+        validate_existing_ancestor_chain(path)?;
+        std::fs::canonicalize(path).map_err(|error| {
+            format!(
+                "解析 PID {pid} 的可执行文件路径失败 [{}]: {error}",
+                path.display()
+            )
+        })
+    }
+
+    fn terminate_and_wait(handle: &OwnedHandle, pid: u32) -> Result<(), String> {
+        if process_has_exited(handle)? {
+            return Ok(());
+        }
+        if unsafe { TerminateProcess(handle.0, 1) } == 0 {
+            if process_has_exited(handle)? {
+                return Ok(());
+            }
+            return Err(format!(
+                "终止进程 PID {pid} 失败: {}",
+                std::io::Error::last_os_error()
+            ));
+        }
+        match unsafe { WaitForSingleObject(handle.0, TERMINATION_WAIT_MS) } {
+            WAIT_OBJECT_0 => Ok(()),
+            WAIT_TIMEOUT => Err(format!("终止进程 PID {pid} 超过 2000ms 仍未退出")),
+            value => Err(format!(
+                "等待进程 PID {pid} 退出失败: WaitForSingleObject={value:#x}"
+            )),
+        }
+    }
+
+    fn handle_agent_marker(
+        file_pid: u32,
+        path: &Path,
+        registry: &Path,
+        initial_pids: &HashSet<u32>,
+    ) -> Result<MarkerDecision, String> {
+        let marker = read_marker(path, file_pid)?;
+        if !initial_pids.contains(&marker.pid) {
+            remove_marker(path, registry)?;
+            return Ok(MarkerDecision::Stale);
+        }
+
+        let handle = match open_terminable_process(marker.pid) {
+            Ok(handle) => handle,
+            Err(open_error) => {
+                if !process_ids()?.contains(&marker.pid) {
+                    remove_marker(path, registry)?;
+                    return Ok(MarkerDecision::Stale);
+                }
+                return Err(open_error);
+            }
+        };
+        if process_has_exited(&handle)? {
+            remove_marker(path, registry)?;
+            return Ok(MarkerDecision::Stale);
+        }
+
+        let creation_time_100ns = process_creation_time(&handle)?;
+        if creation_time_100ns != marker.creation_time_100ns {
+            remove_marker(path, registry)?;
+            return Ok(MarkerDecision::Stale);
+        }
+
+        let marker_executable = canonical_process_path(&marker.executable_path, marker.pid)?;
+        let running_path = process_executable_path(&handle)?;
+        let running_executable = canonical_process_path(&running_path, marker.pid)?;
+        let observed = ObservedProcessIdentity {
+            creation_time_100ns,
+            executable_path: running_executable,
+        };
+        let checked_marker = ProcessMarker {
+            executable_path: marker_executable,
+            ..marker
+        };
+        decide_marker_identity(&checked_marker, Some(&observed))?;
+
+        terminate_and_wait(&handle, checked_marker.pid)?;
+        remove_marker(path, registry)?;
+        Ok(MarkerDecision::Kill)
+    }
+
+    fn terminate_registered_agents(
+        summary: &mut ProcessTerminationSummary,
+        errors: &mut Vec<String>,
+    ) {
+        let registry = match checked_registry_dir() {
+            Ok(Some(registry)) => registry,
+            Ok(None) => return,
+            Err(error) => {
+                errors.push(error);
+                return;
+            }
+        };
+        let markers = match checked_marker_paths(&registry) {
+            Ok(markers) => markers,
+            Err(error) => {
+                errors.push(error);
+                return;
+            }
+        };
+        let initial_pids = match process_ids() {
+            Ok(pids) => pids,
+            Err(error) => {
+                errors.push(error);
+                return;
+            }
+        };
+
+        for (file_pid, path) in markers {
+            match handle_agent_marker(file_pid, &path, &registry, &initial_pids) {
+                Ok(MarkerDecision::Kill) => {
+                    summary.agents_terminated = summary.agents_terminated.saturating_add(1);
+                }
+                Ok(MarkerDecision::Stale) => {
+                    summary.stale_markers_removed = summary.stale_markers_removed.saturating_add(1);
+                }
+                Err(error) => errors.push(error),
+            }
+        }
+    }
+
+    fn terminate_sibling_ui_processes(
+        summary: &mut ProcessTerminationSummary,
+        errors: &mut Vec<String>,
+    ) {
+        let current_pid = std::process::id();
+        let raw_current_executable = match std::env::current_exe() {
+            Ok(path) => path,
+            Err(error) => {
+                errors.push(format!("获取当前 DNA Helper 程序路径失败: {error}"));
+                return;
+            }
+        };
+        let current_executable = match canonical_process_path(&raw_current_executable, current_pid)
+        {
+            Ok(path) => path,
+            Err(error) => {
+                errors.push(error);
+                return;
+            }
+        };
+        let pids = match process_ids() {
+            Ok(pids) => pids,
+            Err(error) => {
+                errors.push(error);
+                return;
+            }
+        };
+
+        for pid in pids {
+            if pid == current_pid {
+                continue;
+            }
+            let handle = match open_terminable_process(pid) {
+                Ok(handle) => handle,
+                Err(_) => continue,
+            };
+            if process_has_exited(&handle).unwrap_or(true) {
+                continue;
+            }
+            let running_path = match process_executable_path(&handle) {
+                Ok(path) => path,
+                Err(_) => continue,
+            };
+            let running_executable = match std::fs::canonicalize(&running_path) {
+                Ok(path) => path,
+                Err(_) => continue,
+            };
+            if running_executable != current_executable {
+                continue;
+            }
+
+            match terminate_and_wait(&handle, pid) {
+                Ok(()) => {
+                    summary.ui_processes_terminated =
+                        summary.ui_processes_terminated.saturating_add(1);
+                }
+                Err(error) => errors.push(error),
+            }
+        }
+    }
+
+    pub(super) fn terminate_all_dna_helper_processes_windows(
+    ) -> Result<ProcessTerminationSummary, String> {
+        let mut summary = ProcessTerminationSummary::default();
+        let mut errors = Vec::new();
+
+        terminate_registered_agents(&mut summary, &mut errors);
+        terminate_sibling_ui_processes(&mut summary, &mut errors);
+
+        if errors.is_empty() {
+            Ok(summary)
+        } else {
+            Err(format!(
+                "部分 DNA Helper 进程未能关闭（Agent 已关闭 {}，其他窗口已关闭 {}，过期 marker 已清理 {}）：{}",
+                summary.agents_terminated,
+                summary.ui_processes_terminated,
+                summary.stale_markers_removed,
+                errors.join("；")
+            ))
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn marker() -> ProcessMarker {
+        ProcessMarker {
+            schema_version: 1,
+            pid: 1234,
+            creation_time_100ns: 133_700_000_000_000_000,
+            executable_path: PathBuf::from(r"C:\Python311\python.exe"),
+        }
+    }
+
+    #[test]
+    fn exact_pid_creation_and_path_match_is_killable() {
+        let marker = marker();
+        let observed = ObservedProcessIdentity {
+            creation_time_100ns: 133_700_000_000_000_000,
+            executable_path: PathBuf::from(r"C:\Python311\python.exe"),
+        };
+        assert_eq!(
+            decide_marker_identity(&marker, Some(&observed)).unwrap(),
+            MarkerDecision::Kill
+        );
+    }
+
+    #[test]
+    fn missing_pid_is_stale() {
+        assert_eq!(
+            decide_marker_identity(&marker(), None).unwrap(),
+            MarkerDecision::Stale
+        );
+    }
+
+    #[test]
+    fn creation_time_mismatch_is_stale_even_when_pid_exists() {
+        let observed = ObservedProcessIdentity {
+            creation_time_100ns: 133_700_000_000_000_001,
+            executable_path: PathBuf::from(r"C:\Python311\python.exe"),
+        };
+        assert_eq!(
+            decide_marker_identity(&marker(), Some(&observed)).unwrap(),
+            MarkerDecision::Stale
+        );
+    }
+
+    #[test]
+    fn executable_path_mismatch_is_an_error() {
+        let observed = ObservedProcessIdentity {
+            creation_time_100ns: 133_700_000_000_000_000,
+            executable_path: PathBuf::from(r"C:\Other\python.exe"),
+        };
+        assert!(decide_marker_identity(&marker(), Some(&observed)).is_err());
+    }
+
+    #[test]
+    fn marker_parser_rejects_unknown_fields_and_pid_mismatch() {
+        let unknown = br#"{
+            "schema_version": 1,
+            "pid": 1234,
+            "creation_time_100ns": 133700000000000000,
+            "executable_path": "C:\\Python311\\python.exe",
+            "unexpected": true
+        }"#;
+        assert!(parse_process_marker(unknown, 1234).is_err());
+
+        let wrong_pid = br#"{
+            "schema_version": 1,
+            "pid": 9999,
+            "creation_time_100ns": 133700000000000000,
+            "executable_path": "C:\\Python311\\python.exe"
+        }"#;
+        assert!(parse_process_marker(wrong_pid, 1234).is_err());
+    }
+
+    #[test]
+    fn termination_summary_serializes_with_camel_case_fields() {
+        let summary = ProcessTerminationSummary {
+            agents_terminated: 1,
+            ui_processes_terminated: 2,
+            stale_markers_removed: 3,
+        };
+        assert_eq!(
+            serde_json::to_value(summary).unwrap(),
+            serde_json::json!({
+                "agentsTerminated": 1,
+                "uiProcessesTerminated": 2,
+                "staleMarkersRemoved": 3,
+            })
+        );
+    }
+}
