+//! Safely terminate DNA Helper Agents and sibling UI processes.
+
+use serde::{Deserialize, Serialize};
+use std::path::{Path, PathBuf};
+
+const PROCESS_MARKER_SCHEMA_VERSION: u32 = 1;
+const MAX_PROCESS_MARKERS: usize = 256;
+const MAX_MARKER_BYTES: u64 = 4096;
+
+#[derive(Clone, Debug, Default, Serialize)]
+#[serde(rename_all = "camelCase")]
+pub struct ProcessTerminationSummary {
+    pub agents_terminated: u32,
+    pub ui_processes_terminated: u32,
+    pub stale_markers_removed: u32,
+}
+
+#[derive(Clone, Debug, Deserialize)]
+#[serde(deny_unknown_fields)]
+struct ProcessMarker {
+    schema_version: u32,
+    pid: u32,
+    creation_time_100ns: u64,
+    executable_path: PathBuf,
+}
+
+#[derive(Clone, Debug)]
+struct ObservedProcessIdentity {
+    creation_time_100ns: u64,
+    executable_path: PathBuf,
+}
+
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+enum MarkerDecision {
+    Kill,
+    Stale,
+}
+
+fn parse_process_marker(bytes: &[u8], file_pid: u32) -> Result<ProcessMarker, String> {
+    if bytes.is_empty() || bytes.len() as u64 >= MAX_MARKER_BYTES {
+        return Err(format!(
+            "Agent marker {file_pid}.json 必须为小于 {MAX_MARKER_BYTES} 字节的非空 JSON"
+        ));
+    }
+
+    let marker: ProcessMarker = serde_json::from_slice(bytes)
+        .map_err(|error| format!("Agent marker {file_pid}.json JSON 无效: {error}"))?;
+    if marker.schema_version != PROCESS_MARKER_SCHEMA_VERSION {
+        return Err(format!(
+            "Agent marker {file_pid}.json schema_version 无效: {}",
+            marker.schema_version
+        ));
+    }
+    if marker.pid == 0 || marker.pid != file_pid {
+        return Err(format!(
+            "Agent marker {file_pid}.json PID 与文件名不一致: {}",
+            marker.pid
+        ));
+    }
+    if marker.creation_time_100ns == 0 {
+        return Err(format!(
+            "Agent marker {file_pid}.json creation_time_100ns 无效"
+        ));
+    }
+    if !marker.executable_path.is_absolute() {
+        return Err(format!(
+            "Agent marker {file_pid}.json executable_path 必须为绝对路径"
+        ));
+    }
+    Ok(marker)
+}
+
+fn decide_marker_identity(
+    marker: &ProcessMarker,
+    observed: Option<&ObservedProcessIdentity>,
+) -> Result<MarkerDecision, String> {
+    let Some(observed) = observed else {
+        return Ok(MarkerDecision::Stale);
+    };
+    if marker.creation_time_100ns != observed.creation_time_100ns {
+        return Ok(MarkerDecision::Stale);
+    }
+    if marker.executable_path != observed.executable_path {
+        return Err(format!(
+            "PID {} 的可执行文件与 Agent marker 不匹配",
+            marker.pid
+        ));
+    }
+    Ok(MarkerDecision::Kill)
+}
