{
    "option": {
        "LiseCombatStartDelay": {
            "type": "input",
            "label": "技能触发延迟（ms）",
            "description": "最低 2000ms。连续确认 Q 未启用后立即判断并锁定本轮高台或非高台结果，然后等待满此时间才执行对应技能；等待期间小地图发生变化不会改变本轮分支。延迟结束后直接按已开启的 E、Q 配置执行，不再重复识别 Q 图标。",
            "inputs": [
                {
                    "name": "delay_ms",
                    "label": "等待时间（ms）",
                    "default": "2000",
                    "pipeline_type": "int",
                    "verify": "^(?:[2-9]\\d{3}|[1-9]\\d{4,})$"
                }
            ],
            "pipeline_override": {
                "LiseCombatLoadDelay": {
                    "post_delay": "{delay_ms}"
                },
                "LiseHighPlatformWindowStart": {
                    "post_delay": 0
                },
                "LiseHighPlatformDetectedDelay": {
                    "pre_delay": "{delay_ms}",
                    "post_delay": 0
                },
                "LiseNonHighPlatformDelay": {
                    "pre_delay": "{delay_ms}",
                    "post_delay": 0
                }
            }
        },
        "LiseHighPlatformOnly": {
            "type": "switch",
            "label": "仅高台释放 E",
            "description": "开启后，连续确认 Q 未启用便立即检查左上角圆形小地图并锁定本轮分支，然后等待满“技能触发延迟”；已锁定高台则按配置释放 E、Q，非高台则不释放 E、但仍按配置释放 Q。关闭后先等待满设定时间，再按配置依次释放 E、Q。技能执行结束后返回结算监控。",
            "default_case": "No",
            "cases": [
                {
                    "name": "Yes",
                    "label": "开启",
                    "pipeline_override": {
                        "LiseCombatLoadDelay": {
                            "enabled": false
                        },
                        "CipherExpelCombatEntry": {
                            "next": [
                                "RewardConfirmByClick",
                                "LiseHighPlatformWindowStart"
                            ]
                        }
                    }
                },
                {
                    "name": "No",
                    "label": "关闭",
                    "pipeline_override": {
                        "LiseCombatLoadDelay": {
                            "enabled": true
                        },
                        "CipherExpelCombatEntry": {
                            "next": [
                                "RewardConfirmByClick",
                                "LisePressE",
                                "LisePressQ",
                                "LiseSkillCastEnd"
                            ]
                        }
                    }
                }
            ]
        },
        "LiseEnableE": {
            "type": "switch",
            "label": "启动 E 键",
            "description": "是否执行 E 键连续点击。",
            "default_case": "Yes",
            "cases": [
                {
                    "name": "Yes",
                    "label": "开启",
                    "pipeline_override": {
                        "LisePressE": {
                            "enabled": true
                        }
                    }
                },
                {
                    "name": "No",
                    "label": "关闭",
                    "pipeline_override": {
                        "LisePressE": {
                            "enabled": false
                        }
                    }
                }
            ]
        },
        "LiseECount": {
            "type": "input",
            "label": "连续点击 E 键的次数",
            "description": "设置每局连续点击 E 键的总次数。",
            "inputs": [
                {
                    "name": "count",
                    "label": "次数",
                    "default": "2",
                    "pipeline_type": "int",
                    "verify": "^[1-9]\\d*$"
                }
            ],
            "pipeline_override": {
                "LisePressE": {
                    "repeat": "{count}"
                }
            }
        },
        "LiseEInterval": {
            "type": "input",
            "label": "连续点击间隔（ms）",
            "description": "每次点击 E 键后等待的毫秒数；最后一次 E 键后同样等待该间隔，再执行 Q 键。",
            "inputs": [
                {
                    "name": "interval_ms",
                    "label": "间隔（ms）",
                    "default": "1000",
                    "pipeline_type": "int",
                    "verify": "^\\d+$"
                }
            ],
            "pipeline_override": {
                "LisePressE": {
                    "repeat_delay": "{interval_ms}",
                    "post_delay": "{interval_ms}"
                }
            }
        },
        "LiseEnableQ": {
            "type": "switch",
            "label": "启动 Q 键",
            "description": "开启后，在战斗开始前连续确认右下角 Q 图标为未启用状态，等待技能触发延迟后点击 Q；若同时执行 E，则在 E 序列及最后一次等待间隔完成后直接点击 Q。",
            "default_case": "Yes",
            "cases": [
                {
                    "name": "Yes",
                    "label": "开启",
                    "pipeline_override": {
                        "LisePressQ": {
                            "enabled": true
                        }
                    }
                },
                {
                    "name": "No",
                    "label": "关闭",
                    "pipeline_override": {
                        "LisePressQ": {
                            "enabled": false
                        }
                    }
                }
            ]
        }
    }
}
