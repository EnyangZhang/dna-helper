{
    "task": [
        {
            "name": "MoonHunterAFK",
            "label": "狩月人之阶挂机",
            "description": "活动副本自动循环任务。可从结算页或已进入的副本接管；连续确认战斗 HUD 后执行三次左键蓄力、Q 与持续 E 动作，结算页识别左下角“重新开始”后停止输入、累计副本轮次并直接重开。",
            "entry": "MoonHunterAFKEntry",
            "option": [
                "MoonHunterAFKRestartCount"
            ],
            "group": [
                "DailyAFK"
            ],
            "controller": [
                "Win32-Foreground"
            ]
        }
    ],
    "option": {
        "MoonHunterAFKRestartCount": {
            "type": "input",
            "label": "副本轮次",
            "description": "设置需要完成多少次狩月人之阶活动副本，范围 1–9999。只有识别到结算页左下角“重新开始”才计入一次完成。",
            "inputs": [
                {
                    "name": "count",
                    "label": "轮次",
                    "default": "1",
                    "pipeline_type": "int",
                    "verify": "^[1-9]\\d{0,3}$"
                }
            ],
            "pipeline_override": {
                "MoonHunterAFKEntry": {
                    "action": {
                        "type": "Custom",
                        "param": {
                            "custom_action": "focus_guard_start",
                            "custom_action_param": {
                                "progress_mode": "狩月人之阶挂机",
                                "progress_total": "{count}",
                                "progress_stage_total": 0
                            }
                        }
                    }
                },
                "MoonHunterAFKRoundQuota": {
                    "max_hit": "{count}",
                    "action": {
                        "type": "Custom",
                        "param": {
                            "custom_action": "moon_hunter_afk_log_round",
                            "custom_action_param": {
                                "total": "{count}"
                            }
                        }
                    }
                },
                "MoonHunterAFKRoundDecision": {
                    "action": {
                        "type": "Custom",
                        "param": {
                            "custom_action": "moon_hunter_afk_decide_restart",
                            "custom_action_param": {
                                "total": "{count}"
                            }
                        }
                    }
                }
            }
        }
    }
}
