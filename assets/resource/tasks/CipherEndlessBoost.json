{
    "task": [
        {
            "name": "CipherEndlessBoost",
            "label": "密函无尽加速",
            "description": "自动处理密函探险结算流程。无尽模式可选择关闭、生物萃取物或精工磁石奖励优先选择；检测到“再次进行”时结束并通过进度监控发送 Telegram 完成通知。驱离模式保持原有奖励确认、轮次重开和可选角色 E、Q 技能组合。",
            "entry": "RewardConfirmEntry",
            "option": [
                "CipherMode"
            ],
            "group": [
                "DailyAFK"
            ],
            "controller": [
                "Win32-Foreground"
            ]
        }
    ],
    "option": {
        "CipherMode": {
            "type": "select",
            "label": "模式",
            "description": "无尽模式默认直接确认当前奖励，可在下拉框指定生物萃取物或精工磁石；检测到“再次进行”时结束。驱离模式保持原有奖励确认、按副本轮次重开及可选技能设置。",
            "default_case": "Endless",
            "cases": [
                {
                    "name": "Endless",
                    "label": "无尽",
                    "option": [
                        "CipherEndlessRedReward"
                    ]
                },
                {
                    "name": "Expel",
                    "label": "驱离",
                    "option": [
                        "CipherExpelRestartCount",
                        "CipherEnableSkills"
                    ],
                    "pipeline_override": {
                        "RewardConfirmEntry": {
                            "action": {
                                "type": "Custom",
                                "param": {
                                    "custom_action": "focus_guard_start",
                                    "custom_action_param": {
                                        "progress_mode": "密函驱离",
                                        "progress_total": 1,
                                        "progress_stage_total": 0
                                    }
                                }
                            },
                            "next": [
                                "CipherExpelEntryMonitor"
                            ]
                        },
                        "RewardConfirmFirstPageClick3Finalize": {
                            "next": [
                                "CipherExpelOutsideMonitor"
                            ]
                        },
                        "CipherExpelAgainClick3Finalize": {
                            "next": [
                                "CipherExpelRestartMonitor"
                            ]
                        },
                        "RewardConfirmThirdPageClick3Finalize": {
                            "next": [
                                "CipherExpelRestartMonitor"
                            ]
                        },
                        "LiseSkillCastEnd": {
                            "next": [
                                "CipherExpelSettlementMonitor"
                            ]
                        }
                    }
                }
            ]
        },
        "CipherExpelRestartCount": {
            "type": "input",
            "label": "副本轮次",
            "description": "设置密函驱离总共完成多少轮副本。轮次只在识别到“再次进行”时增加；达到设定轮数后结束任务，否则点击“再次进行”和 Space 确认进入下一轮。",
            "inputs": [
                {
                    "name": "count",
                    "label": "轮次",
                    "default": "1",
                    "pipeline_type": "int",
                    "verify": "^[1-9]\\d{0,3}$"
                }
            ],
            "pipeline_override": {
                "RewardConfirmEntry": {
                    "action": {
                        "type": "Custom",
                        "param": {
                            "custom_action": "focus_guard_start",
                            "custom_action_param": {
                                "progress_mode": "密函驱离",
                                "progress_total": "{count}",
                                "progress_stage_total": 0
                            }
                        }
                    }
                },
                "CipherExpelRoundQuota": {
                    "max_hit": "{count}",
                    "action": {
                        "type": "Custom",
                        "param": {
                            "custom_action": "cipher_expel_log_round",
                            "custom_action_param": {
                                "total": "{count}"
                            }
                        }
                    }
                },
                "CipherExpelRoundDecision": {
                    "action": {
                        "type": "Custom",
                        "param": {
                            "custom_action": "cipher_expel_decide_restart",
                            "custom_action_param": {
                                "total": "{count}"
                            }
                        }
                    }
                }
            }
        },
        "CipherEnableSkills": {
            "type": "switch",
            "label": "是否开启技能",
            "description": "开启后显示并执行密函驱离的角色技能设置；关闭时只处理副本结算与重新进入，不检测或释放角色技能。",
            "default_case": "No",
            "cases": [
                {
                    "name": "Yes",
                    "label": "开启",
                    "option": [
                        "LiseCombatStartDelay",
                        "LiseHighPlatformOnly",
                        "LiseEnableE",
                        "BackgroundSkillInput"
                    ],
                    "pipeline_override": {
                        "RewardConfirmFirstPageClick3Finalize": {
                            "next": [
                                "CipherPostSkillOutsideMonitor"
                            ]
                        },
                        "CipherExpelAgainClick3Finalize": {
                            "next": [
                                "CipherExpelRestartMonitor"
                            ]
                        }
                    }
                },
                {
                    "name": "No",
                    "label": "关闭",
                    "pipeline_override": {
                        "CipherExpelMonitor": {
                            "next": [
                                "RewardConfirmByClick",
                                "CipherExpelInsideGate",
                                "CipherExpelAgainDetected",
                                "RewardConfirmThirdPageByClick",
                                "CipherExpelInsideIdle"
                            ]
                        }
                    }
                }
            ]
        },
        "CipherEndlessRedReward": {
            "type": "select",
            "label": "优先选择奖励",
            "description": "关闭时直接确认当前奖励。选择生物萃取物或精工磁石后，从左到右选第一个对应物品：第1张命中则直接确认；否则选中第2或3张后直接确认；未命中则确认默认奖励。仅适用于密函无尽。",
            "default_case": "No",
            "cases": [
                {
                    "name": "No",
                    "label": "关闭",
                    "pipeline_override": {
                        "CipherEndlessRewardPage": {
                            "enabled": false,
                            "recognition": {
                                "type": "Custom",
                                "param": {
                                    "custom_recognition": "cipher_reward",
                                    "custom_recognition_param": {
                                        "mode": "page",
                                        "reward_type": "BioExtract"
                                    }
                                }
                            }
                        },
                        "CipherEndlessRewardDefault": {
                            "enabled": true
                        },
                        "CipherEndlessRewardConfirm": {
                            "recognition": {
                                "type": "Custom",
                                "param": {
                                    "custom_recognition": "cipher_reward",
                                    "custom_recognition_param": {
                                        "mode": "ready",
                                        "reward_type": "BioExtract"
                                    }
                                }
                            }
                        },
                        "CipherEndlessRewardSelect2": {
                            "recognition": {
                                "type": "Custom",
                                "param": {
                                    "custom_recognition": "cipher_reward",
                                    "custom_recognition_param": {
                                        "mode": "select",
                                        "slot": 2,
                                        "reward_type": "BioExtract"
                                    }
                                }
                            }
                        },
                        "CipherEndlessRewardSelect3": {
                            "recognition": {
                                "type": "Custom",
                                "param": {
                                    "custom_recognition": "cipher_reward",
                                    "custom_recognition_param": {
                                        "mode": "select",
                                        "slot": 3,
                                        "reward_type": "BioExtract"
                                    }
                                }
                            }
                        }
                    }
                },
                {
                    "name": "Yes",
                    "label": "生物萃取物",
                    "pipeline_override": {
                        "CipherEndlessRewardPage": {
                            "enabled": true,
                            "recognition": {
                                "type": "Custom",
                                "param": {
                                    "custom_recognition": "cipher_reward",
                                    "custom_recognition_param": {
                                        "mode": "page",
                                        "reward_type": "BioExtract"
                                    }
                                }
                            }
                        },
                        "CipherEndlessRewardDefault": {
                            "enabled": false
                        },
                        "CipherEndlessRewardConfirm": {
                            "recognition": {
                                "type": "Custom",
                                "param": {
                                    "custom_recognition": "cipher_reward",
                                    "custom_recognition_param": {
                                        "mode": "ready",
                                        "reward_type": "BioExtract"
                                    }
                                }
                            }
                        },
                        "CipherEndlessRewardSelect2": {
                            "recognition": {
                                "type": "Custom",
                                "param": {
                                    "custom_recognition": "cipher_reward",
                                    "custom_recognition_param": {
                                        "mode": "select",
                                        "slot": 2,
                                        "reward_type": "BioExtract"
                                    }
                                }
                            }
                        },
                        "CipherEndlessRewardSelect3": {
                            "recognition": {
                                "type": "Custom",
                                "param": {
                                    "custom_recognition": "cipher_reward",
                                    "custom_recognition_param": {
                                        "mode": "select",
                                        "slot": 3,
                                        "reward_type": "BioExtract"
                                    }
                                }
                            }
                        }
                    }
                },
                {
                    "name": "Magnet",
                    "label": "精工磁石",
                    "pipeline_override": {
                        "CipherEndlessRewardPage": {
                            "enabled": true,
                            "recognition": {
                                "type": "Custom",
                                "param": {
                                    "custom_recognition": "cipher_reward",
                                    "custom_recognition_param": {
                                        "mode": "page",
                                        "reward_type": "Magnet"
                                    }
                                }
                            }
                        },
                        "CipherEndlessRewardDefault": {
                            "enabled": false
                        },
                        "CipherEndlessRewardConfirm": {
                            "recognition": {
                                "type": "Custom",
                                "param": {
                                    "custom_recognition": "cipher_reward",
                                    "custom_recognition_param": {
                                        "mode": "ready",
                                        "reward_type": "Magnet"
                                    }
                                }
                            }
                        },
                        "CipherEndlessRewardSelect2": {
                            "recognition": {
                                "type": "Custom",
                                "param": {
                                    "custom_recognition": "cipher_reward",
                                    "custom_recognition_param": {
                                        "mode": "select",
                                        "slot": 2,
                                        "reward_type": "Magnet"
                                    }
                                }
                            }
                        },
                        "CipherEndlessRewardSelect3": {
                            "recognition": {
                                "type": "Custom",
                                "param": {
                                    "custom_recognition": "cipher_reward",
                                    "custom_recognition_param": {
                                        "mode": "select",
                                        "slot": 3,
                                        "reward_type": "Magnet"
                                    }
                                }
                            }
                        }
                    }
                }
            ]
        }
    }
}
