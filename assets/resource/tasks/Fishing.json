{
    "task": [
        {
            "name": "Fishing",
            "label": "挂机钓鱼",
            "description": "用于大世界钓鱼地点。识别鱼竿图标发送 Space、鱼形图标发送 E、关闭提示发送 Esc；达到设定数量，或识别到“水中暂时无鱼”时自动结束，后者会通知 Telegram 鱼池已空。",
            "entry": "FishingEntry",
            "option": ["FishingCount", "FishingBackgroundInput"],
            "group": ["DailyAFK"],
            "controller": ["Win32-Foreground"]
        }
    ],
    "option": {
        "FishingCount": {
            "type": "input",
            "label": "钓鱼数量",
            "description": "设置本次挂机需要完成的钓鱼数量。每次成功发送 Esc 计 1，Space 和 E 不计数；达到数量后自动结束任务。范围 1–9999。",
            "inputs": [
                {
                    "name": "count",
                    "label": "数量",
                    "default": "120",
                    "pipeline_type": "int",
                    "verify": "^[1-9]\\d{0,3}$"
                }
            ],
            "pipeline_override": {
                "FishingEntry": {
                    "action": {
                        "type": "Custom",
                        "param": {
                            "custom_action": "focus_guard_start",
                            "custom_action_param": {
                                "progress_mode": "挂机钓鱼",
                                "progress_total": "{count}",
                                "progress_stage_total": 0
                            }
                        }
                    }
                }
            }
        },
        "FishingBackgroundInput": {
            "type": "switch",
            "label": "首次前台触发，后续后台发送（实验）",
            "description": "Space、E、Esc 共用此开关。关闭时全部使用默认前台真实输入；开启后，本任务第一次按键使用前台真实输入并恢复原窗口，后续三个按键都改用后台窗口消息。后台发送成功只代表 Windows 接受消息，不能保证游戏一定处理。",
            "default_case": "No",
            "cases": [
                {
                    "name": "Yes",
                    "label": "开启",
                    "pipeline_override": {
                        "FishingPromptDetected": {
                            "action": {
                                "type": "Custom",
                                "param": {
                                    "custom_action": "hybrid_fishing_action",
                                    "custom_action_param": {
                                        "kind": "key",
                                        "key": 32,
                                        "repeat": 1,
                                        "restore_delay_ms": 100,
                                        "fishing_log_key": "Space"
                                    }
                                }
                            }
                        },
                        "FishingEPromptDetected": {
                            "action": {
                                "type": "Custom",
                                "param": {
                                    "custom_action": "hybrid_fishing_action",
                                    "custom_action_param": {
                                        "kind": "key",
                                        "key": 69,
                                        "repeat": 1,
                                        "proxy_node": "FishingEKeyProxy",
                                        "track_e_sequence": false,
                                        "restore_delay_ms": 100,
                                        "fishing_log_key": "E"
                                    }
                                }
                            }
                        },
                        "FishingClosePromptDetected": {
                            "action": {
                                "type": "Custom",
                                "param": {
                                    "custom_action": "hybrid_fishing_action",
                                    "custom_action_param": {
                                        "kind": "key",
                                        "key": 27,
                                        "repeat": 1,
                                        "proxy_node": "FishingEscapeKeyProxy",
                                        "restore_delay_ms": 100,
                                        "progress_event": "fishing_caught",
                                        "fishing_log_key": "Esc"
                                    }
                                }
                            }
                        }
                    }
                },
                {"name": "No", "label": "关闭"}
            ]
        }
    }
}
