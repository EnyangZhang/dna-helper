{
    "task": [
        {
            "name": "NormalEndlessBoost",
            "label": "普通无尽加速",
            "description": "自动处理普通副本循环。扼守和驱离按设定副本轮次运行；无尽模式仅快速点击局内的“继续挑战”和“确认选择”并记录局内轮次；扼守与驱离均可通过“是否开启技能”启用角色 E、Q 技能组合。",
            "entry": "NormalEndlessEntry",
            "option": [
                "NormalMode"
            ],
            "group": [
                "DailyAFK"
            ],
            "controller": [
                "Win32-Foreground"
            ]
        }
    ],
    "option": {
        "NormalMode": {
            "type": "select",
            "label": "模式",
            "description": "选择普通副本的执行模式。扼守和驱离按副本轮次运行；无尽模式仅监听并快速点击局内的“继续挑战”和“确认选择”，记录局内轮次但不处理副本轮次或角色技能；扼守与驱离可分别开启角色技能设置。",
            "default_case": "Endless",
            "cases": [
                {
                    "name": "Endless",
                    "label": "扼守",
                    "option": [
                        "NormalEndlessRestartCount",
                        "NormalHoldEnableSkills"
                    ],
                    "pipeline_override": {
                        "NormalEndlessEntry": {
                            "next": [
                                "NormalOutsideMonitor"
                            ]
                        },
                        "NormalEndlessMonitor": {
                            "next": [
                                "NormalEndlessContinueChallenge",
                                "NormalEndlessConfirmChoice",
                                "NormalEndlessIdle"
                            ]
                        },
                        "NormalEndlessContinueChallengeClick3": {
                            "next": [
                                "NormalHoldInsideGate"
                            ]
                        },
                        "NormalEndlessConfirmChoiceClick3": {
                            "next": [
                                "NormalHoldInsideGate"
                            ]
                        },
                        "NormalEndlessIdle": {
                            "next": [
                                "NormalHoldInsideGate"
                            ]
                        },
                        "NormalEndlessCombatEntry": {
                            "next": [
                                "NormalEndlessContinueChallenge",
                                "NormalEndlessConfirmChoice",
                                "LiseSkillOrderEntry",
                                "LiseSkillCastEnd"
                            ]
                        },
                        "LiseCombatLoadDelay": {
                            "next": [
                                "NormalEndlessCombatEntry"
                            ]
                        },
                        "LiseSkillCastEnd": {
                            "next": [
                                "NormalHoldPostSkillInsideGate"
                            ]
                        }
                    }
                },
                {
                    "name": "Infinite",
                    "label": "无尽",
                    "pipeline_override": {
                        "NormalEndlessEntry": {
                            "action": {
                                "type": "Custom",
                                "param": {
                                    "custom_action": "focus_guard_start",
                                    "custom_action_param": {
                                        "progress_mode": "普通无尽",
                                        "progress_total": 0,
                                        "progress_stage_total": 0
                                    }
                                }
                            },
                            "next": [
                                "NormalEndlessMonitor"
                            ]
                        },
                        "NormalEndlessMonitor": {
                            "next": [
                                "NormalEndlessContinueChallenge",
                                "NormalEndlessConfirmChoice",
                                "NormalEndlessIdle"
                            ]
                        },
                        "NormalEndlessContinueChallenge": {
                            "action": {
                                "type": "Custom",
                                "param": {
                                    "custom_action": "focus_guard_action",
                                    "custom_action_param": {
                                        "kind": "click",
                                        "target": [
                                            900,
                                            500
                                        ],
                                        "repeat": 3,
                                        "interval_ms": 50,
                                        "restore_delay_ms": 100,
                                        "progress_event": "continue_challenge"
                                    }
                                }
                            },
                            "next": [
                                "NormalEndlessMonitor"
                            ]
                        },
                        "NormalEndlessConfirmChoice": {
                            "action": {
                                "type": "Custom",
                                "param": {
                                    "custom_action": "focus_guard_action",
                                    "custom_action_param": {
                                        "kind": "click",
                                        "target": [
                                            640,
                                            505
                                        ],
                                        "repeat": 3,
                                        "interval_ms": 50,
                                        "restore_delay_ms": 100
                                    }
                                }
                            },
                            "next": [
                                "NormalEndlessMonitor"
                            ]
                        }
                    }
                },
                {
                    "name": "Expel",
                    "label": "驱离",
                    "option": [
                        "NormalExpelRestartCount",
                        "NormalExpelEnableSkills"
                    ],
                    "pipeline_override": {
                        "NormalEndlessEntry": {
                            "next": [
                                "NormalOutsideMonitor"
                            ]
                        },
                        "NormalEndlessAgainDetected": {
                            "next": [
                                "NormalExpelRoundQuota"
                            ]
                        },
                        "NormalEndlessRestartClick3": {
                            "focus": {
                                "Node.Action.Succeeded": {
                                    "content": "[普通驱离] 已点击再次进行，等待开始挑战",
                                    "display": [
                                        "log"
                                    ]
                                }
                            }
                        },
                        "NormalEndlessStartChallengeClick3": {
                            "focus": {
                                "Node.Action.Succeeded": {
                                    "content": "[普通驱离] 已点击开始挑战，进入下一轮副本",
                                    "display": [
                                        "log"
                                    ]
                                }
                            },
                            "next": [
                                "NormalEndlessWaitStartChallenge"
                            ]
                        },
                        "LiseCombatLoadDelay": {
                            "next": [
                                "NormalExpelCombatEntry"
                            ]
                        },
                        "NormalOutsideCombatHudReady": {
                            "next": [
                                "NormalExpelInsideGate"
                            ]
                        },
                        "NormalRestartCombatHudReady": {
                            "next": [
                                "NormalExpelInsideGate"
                            ]
                        },
                        "NormalPostSkillCombatHudReady": {
                            "next": [
                                "NormalExpelPostSkillInsideGate"
                            ]
                        },
                        "LiseSkillCastEnd": {
                            "next": [
                                "NormalExpelPostSkillInsideGate"
                            ]
                        }
                    }
                }
            ]
        },
        "NormalHoldEnableSkills": {
            "type": "switch",
            "label": "是否开启技能",
            "description": "开启后显示并执行普通扼守的角色技能设置；关闭时只处理副本轮次与结算，不释放角色技能。",
            "default_case": "No",
            "cases": [
                {
                    "name": "Yes",
                    "label": "开启",
                    "option": [
                        "NormalHoldCombatStartDelay",
                        "NormalHoldEnableE"
                    ],
                    "pipeline_override": {
                        "NormalOutsideCombatHudReady": {
                            "next": [
                                "LiseCombatLoadDelay"
                            ]
                        },
                        "NormalRestartCombatHudReady": {
                            "next": [
                                "LiseCombatLoadDelay"
                            ]
                        },
                        "NormalEndlessContinueChallengeClick3": {
                            "next": [
                                "NormalEndlessCombatEntry"
                            ]
                        },
                        "NormalEndlessConfirmChoiceClick3": {
                            "next": [
                                "NormalEndlessCombatEntry"
                            ]
                        },
                        "NormalEndlessIdle": {
                            "next": [
                                "NormalEndlessCombatEntry"
                            ]
                        }
                    }
                },
                {
                    "name": "No",
                    "label": "关闭"
                }
            ]
        },
        "NormalExpelEnableSkills": {
            "type": "switch",
            "label": "是否开启技能",
            "description": "开启后显示并执行普通驱离的角色技能设置；关闭时只处理副本结算与重新进入，不检测或释放角色技能。",
            "default_case": "No",
            "cases": [
                {
                    "name": "Yes",
                    "label": "开启",
                    "option": [
                        "LiseCombatStartDelay",
                        "NormalLiseHighPlatformOnly",
                        "LiseEnableE"
                    ],
                    "pipeline_override": {
                        "NormalOutsideCombatHudReady": {
                            "next": [
                                "LiseCombatLoadDelay"
                            ]
                        },
                        "NormalRestartCombatHudReady": {
                            "next": [
                                "LiseCombatLoadDelay"
                            ]
                        },
                        "NormalExpelCombatEntry": {
                            "next": [
                                "LiseSkillOrderEntry",
                                "LiseSkillCastEnd"
                            ]
                        },
                        "LiseCombatLoadDelay": {
                            "next": [
                                "NormalExpelCombatEntry"
                            ]
                        }
                    }
                },
                {
                    "name": "No",
                    "label": "关闭"
                }
            ]
        },
        "NormalEndlessRestartCount": {
            "type": "input",
            "label": "副本轮次",
            "description": "设置总共完成多少个 99 轮副本。填写 1 时完成当前副本后结束；填写 2 时点击一次“再次进行”，再完成一个 99 轮副本后结束。",
            "inputs": [
                {
                    "name": "count",
                    "label": "轮次",
                    "default": "1",
                    "pipeline_type": "int",
                    "verify": "^[1-9]\\d{0,2}$"
                }
            ],
            "pipeline_override": {
                "NormalEndlessEntry": {
                    "action": {
                        "type": "Custom",
                        "param": {
                            "custom_action": "focus_guard_start",
                            "custom_action_param": {
                                "progress_mode": "普通扼守",
                                "progress_total": "{count}",
                                "progress_stage_total": 99
                            }
                        }
                    }
                },
                "NormalEndlessRestartQuota": {
                    "max_hit": "{count}",
                    "action": {
                        "type": "Custom",
                        "param": {
                            "custom_action": "normal_endless_log_round",
                            "custom_action_param": {
                                "total": "{count}"
                            }
                        }
                    }
                },
                "NormalEndlessRoundDecision": {
                    "action": {
                        "type": "Custom",
                        "param": {
                            "custom_action": "normal_endless_decide_restart",
                            "custom_action_param": {
                                "total": "{count}"
                            }
                        }
                    }
                }
            }
        },
        "NormalExpelRestartCount": {
            "type": "input",
            "label": "副本轮次",
            "description": "设置普通驱离总共完成多少轮副本，范围 1–9999。填写 1 时完成当前副本后结束；填写 2 时点击一次“再次进行”和“开始挑战”，再完成一轮后结束。",
            "inputs": [
                {
                    "name": "count",
                    "label": "轮次",
                    "default": "1",
                    "pipeline_type": "int",
                    "verify": "^[1-9]\\d{0,3}$"
                }
            ],
            "pipeline_override": {
                "NormalEndlessEntry": {
                    "action": {
                        "type": "Custom",
                        "param": {
                            "custom_action": "focus_guard_start",
                            "custom_action_param": {
                                "progress_mode": "普通驱离",
                                "progress_total": "{count}",
                                "progress_stage_total": 0
                            }
                        }
                    }
                },
                "NormalExpelRoundQuota": {
                    "max_hit": "{count}",
                    "action": {
                        "type": "Custom",
                        "param": {
                            "custom_action": "normal_expel_log_round",
                            "custom_action_param": {
                                "total": "{count}"
                            }
                        }
                    }
                },
                "NormalExpelRoundDecision": {
                    "action": {
                        "type": "Custom",
                        "param": {
                            "custom_action": "normal_expel_decide_restart",
                            "custom_action_param": {
                                "total": "{count}"
                            }
                        }
                    }
                }
            }
        },
        "NormalHoldCombatStartDelay": {
            "type": "input",
            "label": "技能触发延迟（ms）",
            "description": "进入每轮副本后等待此时间，再按配置的先后顺序执行 E、Q；最低 2000ms。技能结束后返回扼守结算监听。",
            "inputs": [
                {
                    "name": "delay_ms",
                    "label": "等待时间（ms）",
                    "default": "2000",
                    "pipeline_type": "int",
                    "verify": "^(?:[2-9]\\d{3}|[1-9]\\d{4,})$"
                }
            ],
            "pipeline_override": {
                "LiseCombatLoadDelay": {
                    "post_delay": "{delay_ms}"
                }
            }
        },
        "NormalHoldEnableE": {
            "type": "switch",
            "label": "启动 E 键",
            "description": "是否执行 E 键连续点击。关闭后仍可单独开启 Q，但不会显示 Q/E 顺序设置。",
            "default_case": "Yes",
            "cases": [
                {
                    "name": "Yes",
                    "label": "开启",
                    "option": [
                        "LiseECount",
                        "NormalHoldEInterval",
                        "NormalHoldEnableQ"
                    ],
                    "pipeline_override": {
                        "LisePressE": {
                            "enabled": true
                        },
                        "LisePressEAfterQ": {
                            "enabled": true
                        },
                        "LiseQBeforeEIntervalDelay": {
                            "enabled": true
                        }
                    }
                },
                {
                    "name": "No",
                    "label": "关闭",
                    "option": [
                        "LiseEnableQOnly"
                    ],
                    "pipeline_override": {
                        "LisePressE": {
                            "enabled": false
                        },
                        "LisePressEAfterQ": {
                            "enabled": false
                        },
                        "LiseQBeforeEIntervalDelay": {
                            "enabled": false
                        }
                    }
                }
            ]
        },
        "NormalHoldEInterval": {
            "type": "input",
            "label": "连续点击间隔（ms）",
            "description": "普通扼守的 E 连点间隔。Q 在 E 后时，最后一次 E 后也等待该间隔再按 Q；Q 在 E 前时只控制 E 连点本身，Q 后等待时间由单独的“Q 后触发间隔”设置。",
            "inputs": [
                {
                    "name": "interval_ms",
                    "label": "间隔（ms）",
                    "default": "1250",
                    "pipeline_type": "int",
                    "verify": "^\\d+$"
                }
            ],
            "pipeline_override": {
                "LisePressE": {
                    "repeat_delay": "{interval_ms}",
                    "post_delay": "{interval_ms}"
                },
                "LisePressEAfterQ": {
                    "repeat_delay": "{interval_ms}"
                }
            }
        },
        "NormalHoldEnableQ": {
            "type": "switch",
            "label": "启动 Q 键",
            "description": "开启后按所选顺序连续发送 3 次 Q，间隔 100ms。仅当 E、Q 都开启时显示 Q/E 顺序设置。",
            "default_case": "Yes",
            "cases": [
                {
                    "name": "Yes",
                    "label": "开启",
                    "option": [
                        "NormalHoldQBeforeE"
                    ],
                    "pipeline_override": {
                        "LisePressQ": {
                            "enabled": true
                        },
                        "LisePressQBeforeE": {
                            "enabled": true
                        }
                    }
                },
                {
                    "name": "No",
                    "label": "关闭",
                    "pipeline_override": {
                        "LisePressQ": {
                            "enabled": false
                        },
                        "LisePressQBeforeE": {
                            "enabled": false
                        }
                    }
                }
            ]
        },
        "NormalHoldQBeforeE": {
            "type": "switch",
            "label": "Q 在 E 前释放",
            "description": "仅在 E、Q 都开启时显示。开启后先连续发送 3 次 Q，等待“Q 后触发间隔”后再执行 E 连点；最后一次 E 后立即结束技能组合。",
            "default_case": "No",
            "cases": [
                {
                    "name": "Yes",
                    "label": "开启",
                    "option": [
                        "NormalHoldQAfterTriggerDelay"
                    ],
                    "pipeline_override": {
                        "LiseSkillOrderEntry": {
                            "next": [
                                "LisePressQBeforeE",
                                "LisePressEAfterQ",
                                "LiseSkillCastEnd"
                            ]
                        }
                    }
                },
                {
                    "name": "No",
                    "label": "关闭",
                    "pipeline_override": {
                        "LiseSkillOrderEntry": {
                            "next": [
                                "LisePressE",
                                "LisePressQ",
                                "LiseSkillCastEnd"
                            ]
                        },
                        "LisePressE": {
                            "next": [
                                "LisePressQ",
                                "LiseSkillCastEnd"
                            ]
                        }
                    }
                }
            ]
        },
        "NormalHoldQAfterTriggerDelay": {
            "type": "input",
            "label": "Q 后触发间隔（ms）",
            "description": "第三次 Q 发送完成后，等待多少毫秒再开始连续点击 E。仅在“Q 在 E 前释放”开启时显示。",
            "inputs": [
                {
                    "name": "delay_ms",
                    "label": "等待时间（ms）",
                    "default": "2000",
                    "pipeline_type": "int",
                    "verify": "^\\d+$"
                }
            ],
            "pipeline_override": {
                "LiseQBeforeEIntervalDelay": {
                    "pre_delay": "{delay_ms}"
                }
            }
        },
        "NormalLiseHighPlatformOnly": {
            "type": "switch",
            "label": "仅高台释放 E",
            "description": "开启后先锁定左上角小地图的高台或非高台结果，再等待技能触发延迟；高台释放 E、Q，非高台跳过 E 并按 Q 开关决定是否释放 Q。关闭后等待设定时间，再按配置依次释放 E、Q。战斗开始由左下角角色血条 HUD 确认，不检查 Q 图标状态。",
            "default_case": "No",
            "cases": [
                {
                    "name": "Yes",
                    "label": "开启",
                    "pipeline_override": {
                        "LiseCombatLoadDelay": {
                            "enabled": false
                        },
                        "NormalExpelCombatEntry": {
                            "next": [
                                "NormalEndlessAgainDetected",
                                "LiseHighPlatformWindowStart"
                            ]
                        }
                    }
                },
                {
                    "name": "No",
                    "label": "关闭",
                    "pipeline_override": {
                        "LiseCombatLoadDelay": {
                            "enabled": true
                        },
                        "NormalExpelCombatEntry": {
                            "next": [
                                "NormalEndlessAgainDetected",
                                "LiseSkillOrderEntry",
                                "LiseSkillCastEnd"
                            ]
                        }
                    }
                }
            ]
        }
    }
}
